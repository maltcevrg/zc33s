,"pixelHeight":799},"children":[]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"],"anchors":["AJPHSB0P9506006001","AJPHSB0P9506006002"],"images":[{"sourceName":"IGSA0P950008.jpg","path":"images/IGSA0P950008.webp","width":803,"height":796,"sha256":"e098c4178a2fbde05506f33d941e7391d561181ce3f6b51ebfcee86dbbe4271e","sourceSha256":"9768e08c5f3016aafe205edc34708827020df271b7e3bfb755d7ef39e48c14d4","sourceBytes":54721},{"sourceName":"IGSA0P950009.jpg","path":"images/IGSA0P950009.webp","width":533,"height":349,"sha256":"a0950d784c984e537c1b0b922567fb0ad990deece0c9107f7fdea8dd1dbf8326","sourceSha256":"f4876623387a699d2df45e653f98c814cbff16073ddd7bbaf5969a06ae08a694","sourceBytes":14620},{"sourceName":"IGSA0P950010.jpg","path":"images/IGSA0P950010.webp","width":839,"height":799,"sha256":"c8d809511237881898fdc7e6986442cafdfe7fd3332664e90d37a99a76a76127","sourceSha256":"57ff45c2a6d65fe8230c489a08afa1affb4d604a7d4b9641e3651738e4cc3372","sourceBytes":78656},{"sourceName":"IGSA0P950011.jpg","path":"images/IGSA0P950011.webp","width":734,"height":706,"sha256":"d2c7a8153a328ac32024134388e7775c75e77410c7d1152e51766441eb800c2b","sourceSha256":"e088026e636d89ff999c8579f161744ea89a0763c624f073fcb6b2bb347281d3","sourceBytes":57725},{"sourceName":"IGSA0P950012.jpg","path":"images/IGSA0P950012.webp","width":605,"height":616,"sha256":"b0f134c89766cc4eceb6d976d5264557b17912913430210b2e5e2b104434329f","sourceSha256":"bd5436c8bb94a5e0e41b82115653b5bac6cc5435ab655a296ce9f482ef942fad","sourceBytes":45925},{"sourceName":"IGSA0P950013.jpg","path":"images/IGSA0P950013.webp","width":569,"height":594,"sha256":"c234c9a70383822e06ceb4cb18225cca25360701bbd710dde531b6ab13606121","sourceSha256":"ebef56aa58d4805ea256399160d6bcb4e70e8abb3d566615ee3cc58a656a3d48","sourceBytes":45981},{"sourceName":"IGSA0P950014.jpg","path":"images/IGSA0P950014.webp","width":590,"height":576,"sha256":"02151d225d81afa1d72775fa17d028036b1d2b1d49d74bf52d00060eff15669f","sourceSha256":"fbe007f01232415e1a7610a11b05e206f9971588435fe8e48a624339b375d8e1","sourceBytes":46186},{"sourceName":"IGSA0P950015.jpg","path":"images/IGSA0P950015.webp","width":756,"height":799,"sha256":"338a8f21061513f3f4110c0c9f048224a922a3f2955967a3a983ea0e01f8fe05","sourceSha256":"5b0dbaea1e26cc6f5a8db32166adc6f2a56b244b4a79ed35c3d4c56552d122ea","sourceBytes":63618}],"references":[{"targetId":"AJPHSB0P9506005","anchor":"","title":"Схема расположения окон входной двери","available":true},{"targetId":"AJPHSB0P9F06008","anchor":"","title":"Снятие/установка твитера (технические характеристики 6 динамиков)","available":true},{"targetId":"AJPHSB0P9506005","anchor":"","title":"Схема расположения окон входной двери","available":true}],"sourceCounts":{"graphic":8,"table":2,"attention4":1,"intxref":1,"intxrefpoff":1,"intxreftitleoff1":1},"searchText":"Схема расположения окон входной двери Снятие Полностью откройте стекло передней двери. Как показано на рисунке, переместите наружный уплотнитель передней двери (1) в направлении стрелки «1», чтобы освободить язычок (2), затем потяните его в направлении стрелки «2» и снимите с двери. Принудительное удаление уплотнителя может повредить выступы. При снятии руководствуйтесь схемой и будьте осторожны, не прилагайте чрезмерных усилий. 3. внешняя панель передней двери Оставьте примерно 50 мм лобового стекла. “a”: Примерно 50 мм Снимите крышку внутренней ручки (1), крышку внутренней ручки боковой двери (2) и внутреннюю отделку кронштейна створки (3). Для моделей с 6 динамиками снимите разъем высокочастотного динамика. Снятие/установка твитера (технические характеристики 6 динамиков) Выверните винт (4) и зажим (5) и снимите обшивку передней двери (6). Снимите каждый разъем. Со стороны водителя: разъем SW зеркала заднего вида и главный разъем SW электрического стеклоподъемника. Со стороны пассажира: дополнительный разъем SW электрического стеклоподъемника Выверните винт (1) и снимите кронштейн обшивки боковой двери (2). Снимите уплотнительную крышку дверцы (3). Снимите внутренний уплотнитель передней двери (1) и стеклянную направляющую передней двери (2). Выверните нижний винт стекла передней двери (1) и снимите стекло передней двери (2) в направлении стрелки. Установка Для установки выполните процедуру снятия в обратном порядке, но обратите внимание на следующие моменты. Схема расположения окон входной двери Ссылаясь на , затяните каждую деталь с указанным моментом и порядком затяжки. Если стеклянная направляющая передней двери деформирована, замените ее новой. Закрепите уплотнительную крышку передней дверцы (1) бутиловой лентой (2). Установите обшивку передней двери (1) в порядке номеров («от 1» до «3»).","sourceSha256":"2e88478dd0061f272be42c5b292571eeab1ce2b5f92e7b94606c77296c4f59ca","sectionId":"95","groupTitle":"Обслуживание","variant":null}
