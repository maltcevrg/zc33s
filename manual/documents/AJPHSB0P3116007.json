 валом (2).\n"]},"\n",{"tag":"materials","attrs":{},"children":["\n",{"tag":"materialitem","attrs":{"name":"Сузуки Супер Смазка А","id":"M3A105"},"children":["\n",{"tag":"m-part","attrs":{},"children":["\n“A”\n"]},"\n",{"tag":"m-desc","attrs":{},"children":["\nсмазка\n"]},"\n",{"tag":"m-number","attrs":{},"children":["\n99000–25011\n"]},"\n",{"tag":"m-name","attrs":{},"children":["\nСузуки Супер Смазка А\n"]},"\n"]},"\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"I9W10P311013.swf","width":"88.000mm","height":"51.170mm","path":"images/I9W10P311013.webp","pixelWidth":527,"pixelHeight":472},"children":[]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nУстановите пылезащитный чехол тормозного диска и ступицу колеса в сборе, выполнив следующие действия.\n"]},"\n",{"tag":"s2","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nУстановите пылезащитный чехол тормозного диска (1) на ступицу колеса в сборе (2), как показано на рисунке.\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"IGSA0P311013.jpg","width":"88.000mm","height":"51.886mm","path":"images/IGSA0P311013.webp","pixelWidth":493,"pixelHeight":472},"children":[]},"\n",{"tag":"callout","attrs":{},"children":["\n",{"tag":"table","attrs":{},"children":["\n",{"tag":"tgroup","attrs":{"cols":"2"},"children":["\n",{"tag":"colspec","attrs":{"colnum":"1","colname":"1","colwidth":"0.315in"},"children":[]},"\n",{"tag":"colspec","attrs":{"colnum":"2","colname":"2","colwidth":"1.378in"},"children":[]},"\n",{"tag":"tbody","attrs":{},"children":["\n",{"tag":"row","attrs":{},"children":["\n",{"tag":"entry","attrs":{"colname":"1","align":"right"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n[f]:\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"2","align":"left"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nпередняя часть автомобиля\n"]},"\n"]},"\