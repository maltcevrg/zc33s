:"ptxt","attrs":{},"children":["\n(Скорость вращения насоса 4000 об/мин)\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"3","valign":"middle","align":"center"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n22.5 L/min\n"]},"\n"]},"\n"]},"\n",{"tag":"row","attrs":{},"children":["\n",{"tag":"entry","attrs":{"colname":"1","morerows":"1","valign":"middle"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nДавление открытия предохранительного клапана\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"2"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n1-й этап\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"3","align":"center"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n160 ± 40 kPa\n"]},"\n"]},"\n"]},"\n",{"tag":"row","attrs":{},"children":["\n",{"tag":"entry","attrs":{"colname":"2"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n2-й этап\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"3","align":"center"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n360 ± 40 kPa\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"],"anchors":["AJPHSB0PF131020001"],"images":[{"sourceName":"IHSB0PF13012.jpg","path":"images/IHSB0PF13012.webp","width":1663,"height":1012,"sha256":"cc079e336f5d7931758f3f1103eb62f6d7fecbb6bfafac06ecfd038c8bc2e5d4","sourceSha256":"87c75d176a5cc6cb5ccc06551ec777096b024ea7f8b7ca945809d9a8f1aaf058","sourceBytes":90609},{"sourceName":"IHSB0PF13013.jpg","path":"images/IHSB0PF13013.webp","width":529,"height":544,"sha256":"87bfb825cd8a91890b13e329f345412dbc85d8787db1098419c7cad3b81ab647","sourceSha256":"d3934b2b677a6343880293bdbd946026d90a9efbb319c431b08cc83d063028ae","sourceBytes":37514}],"references":[],"sourceCounts":{"graphic":2,"table":3},"searchText":"Масляный насос приводится в движение звездочкой коленчатого вала, а двухступенчатый предохранительный клапан предотвращает чрезмерное давление масла в диапазоне низких и средних оборотов двигателя. В пластине ротора (3) установлены двухступенчатые разгрузочные отверстия №1 (1) и №2 (2). После прогрева двигателя предохранительный клапан работает следующим образом. Когда частота вращения двигателя низкая [a], давление масла сбрасывается из предохранительного отверстия № 1 на сторону впуска (4) корпуса ротора и рециркулируется, уменьшая движущую силу масляного насоса. В этом состоянии предохранительный клапан (5) опускается вниз при низком давлении масла. При высоких оборотах двигателя [b] давление масла аналогичным образом сбрасывается через предохранительное отверстие № 2 и регулируется в пределах стандартного значения. В этом состоянии предохранительный клапан опускается под высоким давлением масла. [A]: Разгрузочное отверстие № 1 открыто [a] [D]: вращение двигателя 8. С двухступенчатым предохранительным клапаном [B]: Разгрузочное отверстие № 2 открыто [b] 6. пружина предохранительного клапана [C]: давление нагнетания масляного насоса 7. Нет двухступенчатого предохранительного клапана Корпус масляного насоса (1) имеет конструкцию, которая одновременно выполняет функцию крышки цепи привода ГРМ, и оснащен масляным каналом для привода VVT (2) и масляным каналом для установки SW давления масла (3). 4. пластина ротора 7. предохранительный клапан 10. Давление масла SW 5. внешний ротор 8. пружина предохранительного клапана 6. Внутренний ротор 9. фиксатор предохранительного клапана Технические данные формат Трохоидный тип Объем нагнетания (давление нагнетания 270 кПа) (Скорость вращения насоса 4000 об/мин) 22.5 L/min Давление открытия предохранительного клапана 1-й этап 160 ± 40 kPa 2-й этап 360 ± 40 kPa","sourceSha256":"a24c534eba5b33bbca4add0db9157e13e92b907aaf0021251cb10da10cd26f2c","sectionId":"F1","groupTitle":"Двигатель","variant":"спорт"}
