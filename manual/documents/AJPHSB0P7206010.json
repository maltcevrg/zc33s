1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nДля спецификаций K14C снимите болт всасывающей трубы (1) и снимите всасывающую трубу (2) и жидкостный шланг (3) с расширительного клапана (4).\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"IGSA0P722020.swf","width":"88.000mm","height":"72.208mm","path":"images/IGSA0P722020.webp","pixelWidth":979,"pixelHeight":763},"children":[]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nСнимите верхнюю отделку капота.\n",{"tag":"intxreftitleoff1","attrs":{"refid":"AJPHSB0P9806005","targetTitle":"Снятие/установка декоративной отделки капота","available":true},"children":["Снятие/установка декоративной отделки капота"]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nСнимите панель приборов. \n",{"tag":"intxreftitleoff1","attrs":{"refid":"AJPHSB0P9306002","targetTitle":"Снятие/установка панели приборов","available":true},"children":["Снятие/установка панели приборов"]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nСнимите задний воздуховод и центральный задний воздуховод.\n",{"tag":"intxreftitleoff1","attrs":{"refid":"AJPHSB0P7206036","targetTitle":"Снятие/установка заднего воздуховода","available":true},"children":["Снятие/установка заднего воздуховода"]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nДля получения технических характеристик CVT снимите контроллер CVT. \n",{"tag":"intxreftitleoff1","attrs":{"refid":"AJPHSB0P5506038","targetTitle":"Снятие/установка TCM (контроллера CVT)","available":false},"children":["Снятие/установка TCM (контроллера CVT)"]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nСнимите блок кондиционера, выполнив следующие действия.\n"]},"\n",{"tag":"s2","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nСняв колпачок гайки блока кондиционера (1), снимите гайку блока кондиционера (2).\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"IGSA0P722021.jpg","width":"88.000mm","height":"56.885mm","path":"images/IGSA0P722021.webp","pixelWidth":821,"pixelHeight":522},"children":[]},"\n"]},"\n"]},"\n",{"tag":"s2","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nСнимите гайку блока кондиционера (3).\n"]},"\n"]},"\n",{"tag":"s2","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nСнимите сливной шланг (4) с кондиционера, а затем снимите блок кондиционера (5).\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"IGSA0P722024.jpg","width":"88.000mm","height":"57.223mm","path":"images/IGSA0P722024.webp","pixelWidth":821,"pixelHeight":526},"children":[]},"\n"]},"\n"]},"\n"]},"\n"]},"\n",{"tag":"servinfosub","attrs":{"id":"AJPHSB0P7206010002"},"children":["\n",{"tag":"title","attrs":{},"children":["\nУстановка\n"]},"\n",{"tag":"ptxt","attrs":{},"children":["\nУстановка выполняется в порядке, обратном снятию, но обратите внимание на следующие моменты.\n"]},"\n",{"tag":"list1","attrs":{"type":"unordered"},"children":["\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nДля спецификаций K10C и K12C используйте новые жидкостные трубы и всасывающие шланги или уплотнительные кольца всасывающей трубы и залейте указанное компрессорное масло.\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nДля спецификаций K14C используйте новые уплотнительные кольца на жидкостном шланге и всасывающей трубе и нанесите указанное компрессорное масло.\n"]},"\n",{"tag":"materials","attrs":{},"children":["\n",{"tag":"materialitem","attrs":{"name":"Денсо ND-12","id":"M7B010"},"children":["\n",{"tag":"m-part","attrs":{},"children":["\n"]},"\n",{"tag":"m-desc","attrs":{}