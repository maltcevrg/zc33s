"\n"]},"\n"],"anchors":["AJPHSB0P8224033001","AJPHSB0P8224033002","AJPHSB0P8224033003","AJPHSB0P8224033004","AJPHSB0P8224033005","AJPHSB0P8224033006","L8B2115","AJPHSB0P8224033007","L8B2116"],"images":[{"sourceName":"IGSA0P822025.swf","path":"images/IGSA0P822025.webp","width":1591,"height":763,"sha256":"1b7f030bdcf6d4ff3683a4da7d83d5cff50c2cc7bfdd743e15c07176296b6718","sourceSha256":"a91ea9296cdd0441c07072179ced9144338f4701f921dc1458387e8cd3e8ddab","sourceBytes":58922},{"sourceName":"IHSB0P822004.swf","path":"images/IHSB0P822004.webp","width":1336,"height":248,"sha256":"91936bfdf9b704d13fb50f5a3aa8ef0e6d1fbe4f284ded05c99df5753bb04392","sourceSha256":"c8d9f9c4f56245010b66ed6913d2fa6f03f64cebb3d118e44827a0943bf33278","sourceBytes":33942}],"references":[{"targetId":"AJPHSB0P8224001","anchor":"","title":"Проверка системы подушек безопасности","available":true},{"targetId":"AJPHSB0P8226003","anchor":"","title":"Как освободить короткий штифт","available":true},{"targetId":"AJPHSB0P8226004","anchor":"","title":"Снятие/установка контроллера подушек безопасности","available":true},{"targetId":"AJPHSB0P8226003","anchor":"","title":"Как освободить короткий штифт","available":true}],"sourceCounts":{"graphic":2,"table":2,"testgroup":3,"result":6,"action":6,"servicetoolitem":2,"intxref":1,"intxreftitleoff1":3},"searchText":"Условия обнаружения DTC и возможные места неисправности Условие обнаружения Возможное место неисправности B1071-14: Неисправность массы системы преднатяжителя левого заднего сиденья. Цепь преднатяжителя левого ремня безопасности заднего сиденья замкнута на массу. Цепь преднатяжителя левого/правого ремня безопасности заднего сиденья контроллер подушек безопасности B1072-14: Неисправность на массу системы преднатяжителя правого заднего сиденья. Цепь преднатяжителя правого ремня безопасности заднего сиденья замкнута на массу. принципиальная схема [A]: Разъемы «L275» и «L276» (вид стрелки: [a]) A3: Цепь сигнала массы левого преднатяжителя ремня безопасности заднего сиденья 4. короткая булавка [B]: Разъем «G343» (вид стрелки: [a]) A4: Выходная цепь сигнала преднатяжителя левого ремня безопасности заднего сиденья 5. жгут панели приборов [C]: Разъем «G12» (вид стрелки: [a]) 1. Преднатяжитель правого ремня безопасности заднего сиденья 6. напольная обвязка A1: Цепь сигнала массы правого преднатяжителя ремня безопасности заднего сиденья 2. Преднатяжитель левого ремня безопасности заднего сиденья A2: Выходная цепь сигнала преднатяжителя правого ремня безопасности заднего сиденья 3. контроллер подушек безопасности Диагностика неисправностей Вы проводили «проверку системы подушек безопасности»? Перейдите к шагу 2. Проверка системы подушек безопасности: 10 каналов пердеть. Проверка цепи преднатяжителя ремня безопасности Выключите зажигание. Снимите разъем «L275» или «L276» с правого/левого заднего преднатяжителя ремня безопасности. Отсоедините разъем «G12» от контроллера подушек безопасности. Освободите короткий штифт на разъеме контроллера подушки безопасности. Как освободить короткий штифт Выполните следующие проверки. Сопротивление между цепями «A1» и «A2» с массой кузова (DTC B1071-14): бесконечное. Сопротивление между цепями «A3» и «A4» с массой кузова (DTC B1072-14): бесконечное. Специальный инструмент 09932–76010 Результаты проверки хорошие? Замените контроллер подушек безопасности и еще раз проверьте коды DTC. Снятие/установка контроллера подушек безопасности Перейдите к шагу 3. Проверка цепи жгута панели приборов Снимите разъем «G343». Освободите короткий штифт на разъеме контроллера подушки безопасности. Как освободить короткий штифт Выполните следующие проверки. Сопротивление между цепями «A1» и «A2» и массой кузова (DTC B1071-14): бесконечное. Сопротивление между цепями «A3» и «A4» с массой кузова (DTC B1072-14): бесконечное. Специальный инструмент 09932–76010 Результаты проверки хорошие? Замените напольную обвязку. Замените жгут панели приборов.","sourceSha256":"42d1673c8645cff803ceff435cae3bc950ce164987c5d0ade37dc824e844e653","sectionId":"82","groupTitle":"Диагностика","variant":"10ch"}
