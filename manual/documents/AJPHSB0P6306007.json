006"],"images":[{"sourceName":"IFKA0P630014.swf","path":"images/IFKA0P630014.webp","width":673,"height":500,"sha256":"ad1ba4f0851d94e6d1a7bab298672fa0ed5a943c9c3e922f52dc56afd7862fe8","sourceSha256":"7e11ac00255d96e431b77dcbc710a4f5187fe7a447ebd4c1a8c0a19c0d00a618","sourceBytes":39963},{"sourceName":"IFKA0P630015.swf","path":"images/IFKA0P630015.webp","width":680,"height":565,"sha256":"ce6fa2a925c71281f5e0224297cdd4c9722ced4f2b4bf7bfbc7c317a955e9234","sourceSha256":"ab6588a16812b90b81d969e0539332aa514a59c44015e1cb98128f0a44ece5e8","sourceBytes":43891},{"sourceName":"IE3J0P630043.swf","path":"images/IE3J0P630043.webp","width":862,"height":786,"sha256":"023628124f2c1bf2172b303a1520605eeb0e01089c8060916900dd75e11f2dce","sourceSha256":"546ba99a010d1d2309441e6e7434133a8e7705041784a91bc3077754fb6c00d9","sourceBytes":54361},{"sourceName":"IE3J0P630044.swf","path":"images/IE3J0P630044.webp","width":443,"height":418,"sha256":"315cb563f59c61c178ccf65d95a66f736c06cdfd19fd041d670d12994d1a88a4","sourceSha256":"bfc711678de8768280fabd4bdcc2510f31882558b0954a6de5a6292ca692f035","sourceBytes":18021}],"references":[{"targetId":"AJPHSB0P6306001","anchor":"","title":"Схема устройства рулевого механизма","available":true},{"targetId":"AJPHSB0P6306006","anchor":"","title":"Снятие/установка рулевого редуктора","available":true},{"targetId":"AJPHSB0P6306006","anchor":"","title":"Снятие/установка рулевого редуктора","available":true}],"sourceCounts":{"graphic":4,"table":1,"servicetoolitem":4,"attention3":1,"intxrefpoff":1,"intxreftitleoff1":2},"searchText":"Схема устройства рулевого механизма Снятие Снимите рулевой механизм. Снятие/установка рулевого редуктора Снимите кожух рулевого механизма. Снимите втулку рулевого механизма с помощью специального инструмента и нажмите (1). Специальный инструмент (A) 09943–88211 (B) 09914–87210 Установка Используя специальный инструмент и нажав (1), впрессуйте новую втулку рулевого редуктора (2) в рулевой редуктор (3), обращая внимание на следующие моменты. После запрессовки убедитесь, что на воротнике втулки нет трещин и повреждений. На схеме сделайте равными размеры «а» и «б». Левая втулка рулевого редуктора (4) имеет удлиненное отверстие для крепления болта (5), поэтому удлиненное отверстие должно быть ориентировано перпендикулярно продольному направлению автомобиля. Перед установкой втулки рулевого редуктора нанесите на внешнюю сторону втулки мыльную воду и т.п., чтобы облегчить установку втулки. Специальный инструмент (A) 09943–88211 (B) 09914–87210 [A]: левый [B]: передняя часть автомобиля Установите крышку рулевого механизма. Установите коробку рулевого механизма. Снятие/установка рулевого редуктора","sourceSha256":"0ffd61065752529ccaa92b5b81f9947299bba8cda27a6d42a7c7b42c5f04c243","sectionId":"63","groupTitle":"Обслуживание","variant":null}
