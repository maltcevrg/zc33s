ptxt","attrs":{},"children":["\n"]},"\n"]},"\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"IAY301520041.swf","width":"88.000mm","height":"67.848mm","path":"images/IAY301520041.webp","pixelWidth":515,"pixelHeight":620},"children":[]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nИспользуя съемник подшипников (3) и пресс, снимите втулку высокоскоростного синхронизатора и ступицу в сборе (1) и входной вал 3-й передачи (2) с входного вала (4).\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"IAY301520042.swf","width":"88.000mm","height":"70.214mm","path":"images/IAY301520042.webp","pixelWidth":663,"pixelHeight":645},"children":[]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nСнимите игольчатый подшипник третьей передачи с первичного вала.\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nРазберите втулку синхронизатора высокой скорости и ступицу в сборе.\n"]},"\n"]},"\n"]},"\n",{"tag":"servinfosub","attrs":{"id":"AJPHSB0P5226019002"},"children":["\n",{"tag":"title","attrs":{},"children":["\nСборка\n"]},"\n",{"tag":"ptxt","attrs":{},"children":["\n",{"tag":"intxrefpoff","attrs":{"refid":"AJPHSB0P5226021","targetTitle":"Проверка входного вала","available":true},"children":["Проверка входного вала: 6MT"]},"\n"]},"\n",{"tag":"ptxt","attrs":{},"children":["\n",{"tag":"intxrefpoff","attrs":{"refid":"AJPHSB0P5226026","targetTitle":"проверка вала переключения передач","available":true},"children":["Проверка вала переключения: 6MT"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nВдавите легкий подшипник первичного вала (1) в первичный вал (2) с помощью специального инструмента и нажмите.\n"]},"\n",{"tag":"servicetool","attrs":{},"children":["\n",{"tag":"servicetoolitem","attrs":{"id":"L5B255"},"children":["\n",{"tag":"s-part","attrs":{},"children":["\n(A)\n"]},"\n",{"tag":"s-number","attrs":{"num":"09941-74910"},"children":["\n09941–74910\n"]},"\n",{"tag":"ptxt","attrs":{},"children":["\n"]},"\n"]},"\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"IHSB0P522030.swf","width":"88.000mm","height":"61.909mm","path":"images/IHSB0P522030.webp","pixelWidth":418,"pixelHeight":572},"children":[]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nУстановите ступицу высокоскоростного синхронизатора (2) и шпонки высокоскоростного синхронизатора (3) (3 шт.) на втулку высокоскоростного синхронизатора (1), как показано на схеме.\n"]},"\n",{"tag":"attention3","attrs":{},"children":["\n",{"tag":"list1","attrs":{"type":"unordered"},"children":["\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nОбозначения, как установить быстроходную шпонку синхронизатора, нет, но есть направление ее использования в качестве втулки и ступицы в сборе.\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nВнутренний диаметр ступицы высокоскоростного синхронизатора больше, чем ступица синхронизатора 5-й и 6-й передач.\n"]},"\n"]},"\n"]},"\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"IHSB0P522031.swf","width":"88.000mm","height":"79.111mm","path":"images/IHSB0P522031.webp","pixelWidth":551,"pixelHeight":749},"children":[]},"\n",{"tag":"callout","attrs":{},"children":["\n",{"tag":"table","attrs":{},"children":["\n",{"tag":"tgroup","attrs":{"cols":"4"},"children":["\n",{"tag":"colspec","attrs":{"colnum":"1","colname":"1","colwidth":"0.315in"},"children":[]},"\n",{"tag":"colspec","attrs":{"colnum":"2","colname":"2","colwidth":"1.575in"},"children":[]},"\n",{"tag":"colspec","attrs":{"colnum":"3","colname":"3","colwidth":"0.315in"},"children":[]},"\n",{"tag":"colspec","at