010.webp","width":1753,"height":580,"sha256":"610e96db04f60ca438b042ba5ac63babeb127fbcf4ff9e221b190e229335a295","sourceSha256":"9a2c834177f07286eadfaed278c9c880b00d7bdf688c327cc6bd70e48c91b1a6","sourceBytes":65072}],"references":[{"targetId":"AJPHSB0P6304001","anchor":"","title":"Проверка системы EPS","available":true},{"targetId":"AJPHSB0P6304030","anchor":"","title":"Проверка силовой цепи контроллера P/S и цепи заземления","available":true},{"targetId":"AJPHSB0P6206009","anchor":"","title":"Снятие/установка рулевой колонки","available":true}],"sourceCounts":{"graphic":1,"table":2,"testgroup":2,"result":4,"action":4,"intxref":1,"intxreftitleoff1":2},"searchText":"Условия обнаружения DTC и возможные места неисправности Условие обнаружения Возможное место неисправности C1141: Неисправность системы напряжения двигателя. Напряжение цепи контроля выше 0,3 В по отношению к опорному напряжению, или цепь привода двигателя неисправна. Электродвигатель P/S (рулевая колонка в сборе) Контроллер P/S (рулевая колонка в сборе) C1142: Неисправность системы тока двигателя 1. Фактическое значение тока двигателя на 10 А или более превышает значение, указанное в инструкции по току двигателя. C1143: Чрезмерный ток двигателя Фактическое измеренное значение тока двигателя составляет 137 А или более. C1145: Ошибка системы тока двигателя 2 Когда значение индикации тока двигателя составляло 4 А или более, фактическое значение тока двигателя составляло 2 А или меньше. C1146: Ненормальное напряжение двигателя. Напряжение двигателя, рассчитанное в контроллере P/S, показало ненормальное значение. принципиальная схема [A]: Разъем контроллера P/S «E61» (вид стрелки: [a]) 1. к батарее 6. Предохранитель «IG1 SIG2» [B]: Разъем контроллера P/S «G10» (вид стрелки: [a]) 2. К мощности зажигания 7. Блок контроллера P/S/двигателя A1: Линия питания контроллера P/S 3. релейная коробка 8. CPU A2: провод питания зажигания 4. предохранитель «P/S» 9. П/С двигатель A3: Провод заземления контроллера P/S 5. J/B 10. отказоустойчивое реле Процедура воспроизведения кода неисправности Запустите двигатель и выполните неподвижное рулевое управление из стороны в сторону. Диагностика неисправностей Была ли проверена система EPS? Перейдите к шагу 2. Проверка системы EPS пердеть. Проверка цепи питания контроллера P/S и цепи заземления Проверьте цепь питания контроллера P/S и цепь заземления. Проверка силовой цепи контроллера P/S и цепи заземления Результаты проверки хорошие? Замените рулевую колонку в сборе и проверьте еще раз. Снятие/установка рулевой колонки Отремонтируйте или замените неисправную деталь.","sourceSha256":"d2b6611264c5d35169197c62b4d747bf543a16015ade93cff4726fb1e47c0574","sectionId":"63","groupTitle":"Диагностика","variant":null}
