го амортизатора (1), верхнюю шайбу заднего амортизатора (2) и верхнюю втулку № 1 заднего амортизатора (3).\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nСнимите задний амортизатор (4) и верхнюю втулку № 2 заднего амортизатора (5).\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"IGSA0P231005.jpg","width":"88.000mm","height":"56.347mm","path":"images/IGSA0P231005.webp","pixelWidth":731,"pixelHeight":518},"children":[]},"\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"IGSA0P231006.jpg","width":"88.000mm","height":"62.616mm","path":"images/IGSA0P231006.webp","pixelWidth":824,"pixelHeight":580},"children":[]},"\n",{"tag":"callout","attrs":{},"children":["\n",{"tag":"table","attrs":{},"children":["\n",{"tag":"tgroup","attrs":{"cols":"4"},"children":["\n",{"tag":"colspec","attrs":{"colnum":"1","colname":"1","colwidth":"0.315in"},"children":[]},"\n",{"tag":"colspec","attrs":{"colnum":"2","colname":"2","colwidth":"1.378in"},"children":[]},"\n",{"tag":"colspec","attrs":{"colnum":"3","colname":"3","colwidth":"0.315in"},"children":[]},"\n",{"tag":"colspec","attrs":{"colnum":"4","colname":"4","colwidth":"1.378in"},"children":[]},"\n",{"tag":"tbody","attrs":{},"children":["\n",{"tag":"row","attrs":{},"children":["\n",{"tag":"entry","attrs":{"colname":"1","valign":"top","align":"right"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n[A]:\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"2","valign":"top","align":"left"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nвнутренняя сторона\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"3","valign":"top","align":"right"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n[B]:\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"4","valign":"top","align":"left"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nНижняя часть автомобиля\n"]},"\n"]},"\n"]},"\