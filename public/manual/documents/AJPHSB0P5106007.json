af75f1940077363a5923ce44ad9bd3fea5f3ca2ca94","sourceSha256":"00f4d3b31bcfcf185dc6b358372a34a362a1ff7a27453e046e04ad1616085fce","sourceBytes":52641}],"references":[{"targetId":"AJPHSB0P5106001","anchor":"","title":"Удаление значения обучения TCM (контроллера АКПП)","available":true},{"targetId":"AJPHSB0P5106003","anchor":"","title":"Калибровка нейтрального положения","available":true},{"targetId":"AJPHSB0P5106002","anchor":"","title":"Настройка значения обучения TCM (контроллера АКПП)","available":true},{"targetId":"AJPHSB0P5106005","anchor":"","title":"Замена жидкости АКПП","available":true},{"targetId":"AJPHSB0P1616004","anchor":"","title":"Отбор охлаждающей жидкости","available":false},{"targetId":"AJPHSB0P1636004","anchor":"","title":"Отбор охлаждающей жидкости","available":true},{"targetId":"AJPHSB0P5106013","anchor":"","title":"Замена шланга маслоохладителя АКПП","available":true},{"targetId":"AJPHSB0P5106008","anchor":"","title":"Проверка соленоида","available":true},{"targetId":"AJPHSB0P5106031","anchor":"","title":"Проверка датчика температуры масла АКПП","available":true},{"targetId":"AJPHSB0P5106029","anchor":"","title":"Проверка датчика вращения входного вала","available":true},{"targetId":"AJPHSB0P5106013","anchor":"","title":"Замена шланга маслоохладителя АКПП","available":true},{"targetId":"AJPHSB0P1616005","anchor":"","title":"наполнение охлаждающей жидкостью","available":false},{"targetId":"AJPHSB0P1636005","anchor":"","title":"наполнение охлаждающей жидкостью","available":true},{"targetId":"AJPHSB0P5106005","anchor":"","title":"Замена жидкости АКПП","available":true},{"targetId":"AJPHSB0P5106001","anchor":"","title":"Удаление значения обучения TCM (контроллера АКПП)","available":true},{"targetId":"AJPHSB0P5106003","anchor":"","title":"Калибровка нейтрального положения","available":true},{"targetId":"AJPHSB0P5106002","anchor":"","title":"Настройка значения обучения TCM (контроллера АКПП)","available":true}],"sourceCounts":{"graphic":10,"table":2,"torqueitem":3,"materialitem":1,"attention3":2,"attention4":1,"intxref":6,"intxrefpoff":3,"intxreftitleoff1":8},"searchText":"Боковой масляный поддон коробки передач деформируется при снятии, поэтому его повторное использование может привести к утечке масла. Всегда используйте новый боковой масляный поддон коробки передач. Болты бокового масляного поддона коробки передач покрыты средством для предварительного покрытия и могут ослабнуть при повторном использовании. Обязательно используйте новые болты. Если корпус клапана снят или заменен, Удаление значения обучения TCM (контроллера АКПП) 、 Калибровка нейтрального положения и Настройка значения обучения TCM (контроллера АКПП) делать. Удаление Отсоедините отрицательный провод аккумулятора. Поднимите автомобиль. Снимите нижнюю крышку двигателя и нижнюю боковую крышку левого двигателя. Удалите жидкость АКПП. Замена жидкости АКПП Слейте охлаждающую воду. Технические характеристики K10C: Отбор охлаждающей жидкости Технические характеристики K14C: Отбор охлаждающей жидкости Снимите выпускной шланг радиатора. Снимите впускной шланг маслоохладителя АКПП. Замена шланга маслоохладителя АКПП Снимите боковой масляный поддон коробки передач (1). Выверните болт зажима датчика температуры масла АКПП и снимите датчик температуры масла АКПП (1) и зажим датчика температуры масла АКПП (2). Отсоедините каждый разъем электромагнита (1) от электромагнитного клапана. Снимите разъем датчика вращения выходного вала (1) с зажима жгута проводов. Отверните болты корпуса клапана и снимите корпус клапана с картера коробки передач, стараясь не уронить рычаг ручного переключения передач. Корпус клапана крепится тремя типами болтов (болты А (1), В (2) и С (3)). Установка Проверка соленоида Проверка датчика температуры масла АКПП Проверка датчика вращения входного вала Установите тягу стояночного фиксатора (1) на рычаг ручного переключения передач (2) и установите корпус клапана (3) в картер коробки передач. Затяните болты корпуса клапана, длина которых указана в таблице ниже, в порядке номеров («от 1» до «8»), поэтапно и равномерно, до указанного крутящего момента. болт корпуса клапана Длина «а» (мм) Количество использованных штук A (1) 31 2 B (2) 21 5 C (3) 51 1 болт корпуса клапана* a 10 Нм Подсоедините жгут проводов соленоида (со встроенным датчиком температуры масла АКПП) (1) и соедините каждый разъем соленоида (2) и разъем датчика вращения выходного вала (3), как показано ниже. Установите датчик температуры масла АКПП (4) и зажим датчика температуры масла АКПП (5) и затяните болт зажима датчика температуры масла АКПП (6) с указанным моментом затяжки. Болт крепления датчика температуры масла АКПП a 7.0 Нм Очистите сопрягаемые поверхности картера коробки передач и нанесите герметик на новый боковой масляный поддон коробки передач (1). “A” герметик 99000–31230 Три Бонда 1216B “a”: 2.5 mm Затяните новый болт бокового масляного поддона коробки передач указанным моментом затяжки. Болт крепления масляного поддона коробки передач a 13 Нм Установите впускной шланг маслоохладителя АКПП. Замена шланга маслоохладителя АКПП Установите выпускной шланг радиатора. Залейте охлаждающую воду. Технические характеристики K10C: наполнение охлаждающей жидкостью Технические характеристики K14C: наполнение охлаждающей жидкостью Установите двигатель под крышку. Подсоедините отрицательный провод аккумулятора к аккумулятору. Влейте жидкость АКПП. Замена жидкости АКПП Удаление значения обучения TCM (контроллера АКПП) Осуществлять. Калибровка нейтрального положения Осуществлять. Настройка значения обучения TCM (контроллера АКПП) Осуществлять.","sourceSha256":"6efda6c610dd6c69cddf3ea26b4110b17df5a05c720ff986d21923d7d8b9d357","sectionId":"51","groupTitle":"Обслуживание","variant":null}
