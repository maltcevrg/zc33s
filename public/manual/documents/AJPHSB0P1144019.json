sourceName":"IHSB0P114009.swf","path":"images/IHSB0P114009.webp","width":1724,"height":1094,"sha256":"5be1aee7dbd9df01c201bd82a55c448e3773e368c83720c392359886f544097c","sourceSha256":"115946c09d2b3b0c5662175feafb334aa275c03904a62905db282c6bad88c4cc","sourceBytes":144234}],"references":[{"targetId":"AJPHSB0P1144001","anchor":"","title":"Проверка системы управления двигателем","available":true},{"targetId":"AJPHSB0P1736009","anchor":"","title":"Бортовая проверка топливного насоса высокого давления","available":true},{"targetId":"AJPHSB0P1336001","anchor":"","title":"Снятие/установка ECM","available":true},{"targetId":"AJPHSB0P1736010","anchor":"","title":"Снятие/установка топливного насоса высокого давления","available":true}],"sourceCounts":{"graphic":1,"table":2,"testgroup":3,"result":6,"action":6,"intxref":1,"intxreftitleoff1":3},"searchText":"Детали диагностики/предполагаемое местонахождение дефекта Детали диагноза Предполагаемое место дефекта P0090: Неисправность цепи электромагнитного клапана насоса высокого давления. Цепь топливного насоса высокого давления была отключена. (1 логика обнаружения постоянного/постоянного тока) Проводка/разъем топливного насоса высокого давления топливный насос высокого давления ECM P0091: Низкий уровень сигнала в системе регулятора давления топлива. Произошло замыкание на массу в цепи топливного насоса высокого давления. (1 логика обнаружения постоянного/постоянного тока) P0092: Высокая неисправность системы регулятора давления топлива. Цепь топливного насоса высокого давления была закорочена на питание. (1 логика обнаружения постоянного/постоянного тока) принципиальная схема [A]: Разъем ECM (вид стрелки: [a]) B2: Сигнальная линия датчика давления топлива 3. датчик давления топлива A1: Линия питания топливного насоса высокого давления B3: Провод массы датчика давления топлива 4. К датчику давления A2: Привод топливного насоса высокого давления 1. ECM B1: Линия питания датчика давления топлива 2. топливный насос высокого давления Процедура воспроизведения кода неисправности Предпосылки: Выполните действия для воспроизведения при следующих условиях: 16.5 V ＞ напряжение батареи ＞ 8.5 V Запустите двигатель на холостом ходу. Диагностика неисправностей Вы проводили «проверку системы управления двигателем»?？ Перейдите к шагу 2. Проверка системы управления двигателем: K14C Осуществлять. Проверка силовой линии топливного насоса высокого давления и линии привода топливного насоса высокого давления. Выключите зажигание и отсоедините разъемы топливного насоса высокого давления и контроллера ECM. Проверьте клеммные соединения разъема топливного насоса высокого давления и разъема ECM. Если клеммные соединения в порядке, проверьте, что линия питания топливного насоса высокого давления (А1) и линия привода топливного насоса высокого давления (А2) находятся в следующем состоянии. Сопротивление проводов линии питания топливного насоса высокого давления и линии привода топливного насоса высокого давления составляет 1 Ом или менее. Сопротивление изоляции между линией питания топливного насоса высокого давления, линией привода топливного насоса высокого давления и массой кузова бесконечно. Сопротивление изоляции между клеммой линии питания топливного насоса высокого давления разъема ECM и другими клеммами бесконечно. Сопротивление изоляции между клеммой линии привода топливного насоса высокого давления разъема ECM и другими клеммами бесконечно. При включении зажигания напряжение в линии питания ТНВД и линии привода ТНВД составляет примерно 0 В. Результаты проверки хорошие?？ Перейдите к шагу 3. Отремонтируйте или замените неисправную проводку. Проверка топливного насоса высокого давления Проверьте топливный насос высокого давления. Бортовая проверка топливного насоса высокого давления Результаты проверки хорошие?？ Замените ECM и проверьте еще раз. Снятие/установка ECM Замените топливный насос высокого давления. Снятие/установка топливного насоса высокого давления","sourceSha256":"b8bf7000a6d9172e1732073cc481561b2