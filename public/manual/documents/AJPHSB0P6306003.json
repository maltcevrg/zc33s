и\n"]},"\n",{"tag":"t-part1","attrs":{},"children":["\na\n"]},"\n",{"tag":"t-value1","attrs":{},"children":["\n45\n"," Нм"]},"\n"]},"\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"IE3J0P630019.swf","width":"88.000mm","height":"65.149mm","path":"images/IE3J0P630019.webp","pixelWidth":601,"pixelHeight":608},"children":[]},"\n"]},"\n"]},"\n"]},"\n"],"anchors":["AJPHSB0P6306003001","AJPHSB0P6306003002","T6C001","T6C002"],"images":[{"sourceName":"IE3J0P630015.swf","path":"images/IE3J0P630015.webp","width":677,"height":608,"sha256":"ddcc238c36239cffedea9ee865c5972ebb3f66e2434eb2f56ae3042c237fe2e7","sourceSha256":"7c31093b3ce24f7c4e42ef9f514eec69a800b82cd14a6479cd1419c08c710805","sourceBytes":43892},{"sourceName":"IFRA0P630015.jpg","path":"images/IFRA0P630015.webp","width":716,"height":493,"sha256":"a80dc860352805e721213136a05b1c4fc0e267726d554b5f86d844e715e1f612","sourceSha256":"354fad22e91d845fdb7d6c2a6225df579105ee6e922c972faa3e6140faa9bd18","sourceBytes":54706},{"sourceName":"IDAA0A630014.jpg","path":"images/IDAA0A630014.webp","width":716,"height":562,"sha256":"fc93ec67bceeb5506a19fe11006852602cbfd6f8b083a46d99a9d7b44cdbdf86","sourceSha256":"26d90e096e17f5b3cab1f501fac417e12ea013f1d672a03a0a4786068e61b881","sourceBytes":21252},{"sourceName":"IDAA0A630014.jpg","path":"images/IDAA0A630014.webp","width":716,"height":562,"sha256":"fc93ec67bceeb5506a19fe11006852602cbfd6f8b083a46d99a9d7b44cdbdf86","sourceSha256":"26d90e096e17f5b3cab1f501fac417e12ea013f1d672a03a0a4786068e61b881","sourceBytes":21252},{"sourceName":"IE3J0P630018.swf","path":"images/IE3J0P630018.webp","width":677,"height":608,"sha256":"72364cc70b3ddc2ac2145c7763d9470a5dec3c5fd9c0f3220a4518006d5fddc4","sourceSha256":"3a365c736bd5bc9bf8f9b034c0c5eb4c4f12e4bc2d655b387ab8445908616615","sourceBytes":44346},{"sourceName":"IE3J0P630019.swf","path":"images/IE3J0P630019.webp","width":601,"height":608,"sha256":"103d99522ea99b80c67146355d0f91a6ea301de1fe7bc4a44cb92dd24d24e366","sourceSha256":"db8ec876dbbacf9ca4a5a39c088b738a45670fa9a5458c9af4012b2aafef5d5a","sourceBytes":42765}],"references":[{"targetId":"AJPHSB0P6306002","anchor":"","title":"Проверка наконечника рулевой тяги на автомобиле","available":true},{"targetId":"AJPHSB0P6306001","anchor":"","title":"Схема устройства рулевого механизма","available":true},{"targetId":"AJPHSB0P2406001","anchor":"","title":"Снятие/установка колеса (с шиной)","available":true},{"targetId":"AJPHSB0P6306004","anchor":"","title":"Проверка шарового шарнира рулевой тяги","available":true},{"targetId":"AJPHSB0P2406001","anchor":"","title":"Снятие/установка колеса (с шиной)","available":true},{"targetId":"AJPHSB0P2206001","anchor":"","title":"Проверка/регулировка сход-развала передних колес","available":true}],"sourceCounts":{"graphic":6,"torqueitem":2,"attention2":1,"attention3":1,"intxrefpoff":3,"intxreftitleoff1":3},"searchText":"Проверка наконечника рулевой тяги на автомобиле Схема устройства рулевого механизма Удаление Поднимите автомобиль и снимите шины. Снятие/установка колеса (с шиной) Снимите зажим (2) и ослабьте гайку наконечника рулевой тяги (1) до тех пор, пока она не окажется заподлицо с резьбовым концом шарнира. Используя съемник шаровых опор (3), снимите наконечник рулевой тяги (1) с поворотного кулака (2). Съемник шаровых опор может упасть во время работы и нанести травму работнику. Подвесьте его веревкой, чтобы он не упал. Снимите гайку наконечника рулевой тяги. Нанесите метку (1) на резьбовую часть рулевой тяги (4), чтобы указать положение установки контргайки конца рулевой тяги (2). Ослабьте контргайку наконечника рулевой тяги и снимите наконечник рулевой тяги (3) с рулевой тяги. Установка Проверка шарового шарнира рулевой тяги Прикрепите контргайку конца рулевой тяги (2) и конец рулевой тяги (3) к соответствующей отметке (1) на резьбовой части рулевой тяги (4). После проверки схождения затяните контргайку наконечника рулевой тяги с указанным моментом затяжки. Прикрепите конец рулевой тяги к поворотному кулаку и затяните гайку наконечника рулевой тяги (1) с указанным моментом затяжки. гайка наконечника рулевой тяги a 45 Нм Установите новый зажим (2). Установите переднее колесо. Снятие/установка колеса (с шиной) Проверьте схождение. Проверка/регулировка сход-развала передних колес Если схождение находится в пределах указанного диапазона, затяните контргайку наконечника рулевой тяги (1) указанным моментом затяжки. контргайка конца рулевой тяги a 45 Нм","sourceSha256":"934f93b505724f8826d820f95535f9aa2d2e1fe526a8f3e8cf4e4b1745c46148","sectionId":"63","groupTitle":"Обслуживание","variant":null}
