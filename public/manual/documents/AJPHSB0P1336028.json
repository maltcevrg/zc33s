ages/IHSB0P133016.webp","width":756,"height":598,"sha256":"6a9c0e03d96224d3c5d39aeb121bffc6afeed9d947595ae3ef9a10a6492f9ea5","sourceSha256":"5bac3561ddc5fd0bf1ae7ad02e7897f9f6f71091f4eb8f87743c3629b58d6703","sourceBytes":73258},{"sourceName":"IHSB0P133017.swf","path":"images/IHSB0P133017.webp","width":792,"height":576,"sha256":"1420ccfb35d08ca7f6d9395d5c0e34700f5e34cbe1029843959238a8ba9ed8f5","sourceSha256":"30206407a860219c20f9ea30648bcaae3a7a228155132969c9d2770043cccc1f","sourceBytes":73213},{"sourceName":"IFAE0A130034.swf","path":"images/IFAE0A130034.webp","width":756,"height":598,"sha256":"f5b7e8f301d209661b1a5490bfb7286879f7bca55e65372c3196ab44f8327758","sourceSha256":"86d83eac34e5850dee2685addb98e2e34ca02c37776574d1f8c338c611bc680f","sourceBytes":75028},{"sourceName":"IFAE0A130036.swf","path":"images/IFAE0A130036.webp","width":752,"height":576,"sha256":"5881313ddf88602d93e850694a15cc15039257b6117343f7b7a51d1ab29d4627","sourceSha256":"c160a3feba93872abb0dfea40f3cfe594985fbde11ac9e4ac68a988998df3dc4","sourceBytes":68531},{"sourceName":"IFAE0A130037.swf","path":"images/IFAE0A130037.webp","width":749,"height":576,"sha256":"a981d7c0f820f8d57434d51b788c771df76822beb7a9da87b1c07a4d77b7252e","sourceSha256":"97c2ded53f4e6d63da8c9870c68310348dfc5b9874372c183f865aa7b3ae2112","sourceBytes":65768},{"sourceName":"IHSB0P133033.swf","path":"images/IHSB0P133033.webp","width":752,"height":587,"sha256":"b5c8b9b34470a2f23a862d92b41156a9942c241973af19c0697a1398c7da5470","sourceSha256":"119ce34d50695dc681c115fd7297257af5769d2779b6d3946fbd2f4b77071e5f","sourceBytes":69071},{"sourceName":"IHSB0P133018.swf","path":"images/IHSB0P133018.webp","width":749,"height":572,"sha256":"dfed7ceee96e21305bacde76658e74e6d86bb078819ddb1929c3dbee14ad7647","sourceSha256":"01a97a3578082e47977682fb287fc28ee9274aa321ea6a438e08c28d14b560b7","sourceBytes":66482}],"references":[{"targetId":"AJPHSB0P1336030","anchor":"","title":"Воздушный перепускной клапан VSV (ABV-VSV) индивидуальная проверка","available":true}],"sourceCounts":{"graphic":7,"servicetoolitem":2,"attention3":1,"attention4":1,"intxreftitleoff1":1},"searchText":"Приложение слишком большого отрицательного давления может повредить ABV-VSV. Не подавайте на ABV-VSV отрицательное давление -70 кПа или более. Подготовьтесь к операции ABV-VSV. При использовании Suzuki SDT-II Выключите зажигание и подключите Suzuki SDT-II к DLC. Suzuki SDT-II Включите зажигание и проверьте, обнаружен ли какой-либо код неисправности. Если обнаружен код неисправности, для этого кода неисправности выполняется диагностика неисправности. Выберите активный тест. Выключите зажигание. При использовании сервисного провода Выключите зажигание и подсоедините рабочий провод (1) к разъемам ABV-VSV (2) и ABV-VSV так, чтобы рабочий провод можно было подключить к массе кузова. Снимите шланг управления ABV № 1 (1) и шланг управления ABV № 3 (2) с ABV-VSV. Снимите шланг управления ABV № 2 (3) с ABV-VSV. Подсоедините специальный инструмент (А) к шлангу управления ABV № 2. (A) 09917–47011 Включите зажигание. Работу ABV-VSV проверяют следующим образом. ABV-VSV OFF При использовании Suzuki SDT-II: 0% При использовании сервисного провода (1): «Масса» кузова не подключена [a] ABV-VSV ON При использовании Suzuki SDT-II: 100 %. При использовании сервисного провода: Соединение с массой кузова [b] Проверьте, создается ли заданное отрицательное давление (-60 кПа), когда порт (1) закрыт пальцем, когда ABV-VSV выключен. Проверьте, уменьшается ли отрицательное давление при открытии порта (1) при выключенном ABV-VSV. Убедитесь, что указанное отрицательное давление (-60 кПа) применяется, когда ABV-VSV включен и порт (1) закрыт пальцем. Проверьте, уменьшается ли отрицательное давление при открытии порта (1) при включенном ABV-VSV. Если результат проверки отрицательный, проверьте следующие пункты. Проводка и разъемы ABV-VSV Воздушный перепускной клапан VSV (ABV-VSV) индивидуальная проверка Шланг управления ABV №2","sourceSha256":"1febe89e5eaa572fd732ded531412949e78bd9ed919e45143f169b784fc0cb3e","sectionId":"13","groupTitle":"Обслуживание","variant":"K14C"}
