55907252862d980083269ca939c6d766ba3719d8a","sourceSha256":"9fe714fdf8c88660b04fae8dd675191dc710471d5ba52e3993e86e40e50c9352","sourceBytes":20941},{"sourceName":"I8T201920064.swf","path":"images/I8T201920064.webp","width":788,"height":378,"sha256":"348dd61c8b2276e9d8977ac852b5f3bfa221bdda1727c110c1de743065390db4","sourceSha256":"397f96415877f4eb0feed9ac1cbe038d4246ea2452cb433505b860cce60b7ff7","sourceBytes":28079},{"sourceName":"I8B701920016.swf","path":"images/I8B701920016.webp","width":857,"height":675,"sha256":"c09a1ca8583331bcf6db9d199c07f5ad66ea86efb8cba4a769146e7adf08d3c2","sourceSha256":"582855bca01768f9de0061b90ab794299896ff3dbb9d6fd93cd73abca513bdf6","sourceBytes":45656},{"sourceName":"I8T201920066.swf","path":"images/I8T201920066.webp","width":645,"height":435,"sha256":"4ad868f823d8b3c1cd6bc933739cf53f6893755e49170ecf73ee89fb5e62cb7a","sourceSha256":"493e31c1f382a9427f7be1549355adc463f25f6f1f86a29c35272cc00c6cfa5d","sourceBytes":17191},{"sourceName":"I8T201920068.swf","path":"images/I8T201920068.webp","width":689,"height":435,"sha256":"481f93f669514e3de428d3b317d950d0f7892bc3ac4d8015d201623072319fa4","sourceSha256":"86a4f16596c26ce4e07826872a77fdf2883ea49f4ca2a73fc2f893f12d5486bc","sourceBytes":19233}],"references":[{"targetId":"AJPHSB0P2406003","anchor":"","title":"Проверка шин","available":true}],"sourceCounts":{"graphic":8,"table":7,"attention3":1,"intxreftitleoff1":1},"searchText":"Регулировка оптической оси фар и проверка яркости Чтобы определить отметку центра лампы на поверхности линзы фары, обратитесь к следующему рисунку. [A]: Характеристики галогенных фар 1. центр фары [B]: Технические характеристики светодиодных фар Подготовка перед регулировкой оптической оси Установите давление в шинах на стандартное значение. Проверка шин Удалите из автомобиля весь груз, связанный с изменением положения автомобиля, и освободите его. На водительском месте сидит один человек (75 кг). Для галогенных фар установите переключатель регулировки угла наклона фар SW в положение 0. Запустите двигатель и дайте ему поработать на холостом ходу. Метод регулировки прицеливания Отрегулируйте прицеливание, используя следующую схему. Характеристики галогенных фар Технические характеристики светодиодных фар [A]: Левая сторона автомобиля [B]: Правая сторона автомобиля Регулировка оптической оси и проверка силы света с помощью тестера Работы по проверке/регулировке следует выполнять на основании инструкции к используемому тестеру. Регулировка оптической оси и проверка интенсивности света с помощью регулировочного экрана Создайте экран настройки, показанный на рисунке. [a]: Диапазон регулировки точки локтя “d”: 20 mm “a”: Примерно 420 мм “e”: 270 mm “b”: Примерно 350 мм 1. Центр лампы (φ(просверлить 10 отверстий) “c”: 150 mm Припаркуйте автомобиль лицом к стене или подоконнику (1) (перпендикулярно ровной поверхности дороги). Сделайте отметку (3) на стене или встаньте на той же высоте, что и центральное положение фары (2). Совместите центральное отверстие лампы регулировочного экрана (4) с отмеченным положением на стене или пешеходной дорожке и закрепите его параллельно ровной поверхности дороги. [a]: высота центра фары Экран настройки (1) и автомобиль 10 ｍЗатем посмотрите прямо на автомобиль и на экран ([a]＝[б]) “a”: 10 m 2. автомобильный центр Используйте подставку, чтобы свет нерегулируемой фары не попадал на регулировочный экран. Включите фары (ближний свет). Отрегулируйте с помощью направляющего винта так, чтобы точка изгиба (1) ближнего света, освещенная на экране регулировки, попадала в диапазон регулировки (2), показанный на рисунке. [a]: темная часть 3. центр фары [b]: яркая часть 4. светлая и темная граница Убедитесь, что сила света на расстоянии 110 мм ниже и 230 мм левее центра секции освещения составляет 6400 кандел или более на лампу. [a]: темная часть 1. точка локтя [b]: яркая часть 2. Точка измерения интенсивности света “a”: 110 mm 3. центр фары “b”: 230 mm 4. светлая и темная граница","sourceSha256":"f256588eaeac1274b737495cd6cb1f5fbeae7a8f870fe3587d3bda472e6b54a3","sectionId":"92","groupTitle":"Обслуживание","variant":null}
