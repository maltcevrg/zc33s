":"88.000mm","height":"52.905mm","path":"images/IGSA0P9F0014.webp","pixelWidth":670,"pixelHeight":482},"children":[]},"\n"]},"\n"]},"\n"]},"\n",{"tag":"servinfosub","attrs":{"id":"AJPHSB0P9F06003002"},"children":["\n",{"tag":"title","attrs":{},"children":["\nУстановка\n"]},"\n",{"tag":"ptxt","attrs":{},"children":["\nУстановка выполняется в порядке, обратном снятию, но обратите внимание на следующие моменты.\n"]},"\n",{"tag":"list1","attrs":{"type":"unordered"},"children":["\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nПри креплении заземляющего провода (1) поместите клемму заземляющего провода напротив выступа (2) на кронштейне и затяните винт (3).\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"IGSA0P9F0036.jpg","width":"88.000mm","height":"49.098mm","path":"images/IGSA0P9F0036.webp","pixelWidth":817,"pixelHeight":446},"children":[]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"],"anchors":["AJPHSB0P9F06003001","AJPHSB0P9F06003002"],"images":[{"sourceName":"IGSA0P9F0048.swf","path":"images/IGSA0P9F0048.webp","width":824,"height":536,"sha256":"1faf04d593be08c301dc5d1fb40a5037637c422c9fe5833e8580fb0655352779","sourceSha256":"5192b074e0ea34caa10cc079ce047458d40c3a21a85d73c08dbd53aa3fa74f42","sourceBytes":62383},{"sourceName":"IGSA0P9F0049.swf","path":"images/IGSA0P9F0049.webp","width":850,"height":1163,"sha256":"45f73d6da2aa3e945e6f466ffbe0fc713fe30553432ddd93f7dd6cbcfbe24a71","sourceSha256":"62dbbf5bbe41066b740db6183cac45f439e5ab578cb8b9e250c8043c65331b21","sourceBytes":123292},{"sourceName":"IGSA0P9F0050.swf","path":"images/IGSA0P9F0050.webp","width":997,"height":526,"sha256":"2a90265d6e8393fc361fa4311e439a7790e5ab294a391029a1da80582d2ed63e","sourceSha256":"c07f58fcff1c9f0167902bc3a9819f1946fa3e01deecbb115fe764b56fdf3e86","sourceBytes":57110},{"sourceName":"IGSA0P9F0051.swf","path":"images/IGSA0P9F0051.webp","width":832,"height":410,"sha256":"b7b3d6686ea27266a080dde299860d64dcc388ed527d4bda9e66dcc4f52b73c5","sourceSha256":"3c7ba0c813e2bdcf68918cc7755786c6cd13c672b77066b9c96cbeb2282c9eb7","sourceBytes":49602},{"sourceName":"IGSA0P9F0052.swf","path":"images/IGSA0P9F0052.webp","width":976,"height":457,"sha256":"4fbd8d5e30293efb2181784912d05eff2caee23aefd2009188dc425861ab950f","sourceSha256":"66dcad040f0c3092535dc53c10f9cab76c9b67ae5fa58e953ea88e9a75882920","sourceBytes":47928},{"sourceName":"IHSB0P9F0009.jpg","path":"images/IHSB0P9F0009.webp","width":720,"height":695,"sha256":"e50195a99b704b38e1a0fbb1b943e17f116b5fcb943984f50f579a00367b4f2b","sourceSha256":"3c21e08a829e50575154a8cc1974714520bb34beaaa9234ff28fb80ac6596c5a","sourceBytes":64132},{"sourceName":"IGSA0P9F0011.jpg","path":"images/IGSA0P9F0011.webp","width":619,"height":418,"sha256":"92025bd7696dd59e28366787a0ed4f1976af5fddb5bdf3f8046a1ce6ea2843c1","sourceSha256":"e26f6f6ce1406b0cad01766fa2fb9dcc9a3c3f94dca3a056743fc4887324eebe","sourceBytes":26693},{"sourceName":"IGSA0P9F0012.jpg","path":"images/IGSA0P9F0012.webp","width":616,"height":526,"sha256":"8f0d1f958698d8872c98130bc931ec0c493b63a15d65eac31e1ccece0b2e8b4c","sourceSha256":"63c1feab38cc6fd2b2a4f5c6c8c0e411bc244f198530203177e6763ec7e94e2a","sourceBytes":32674},{"sourceName":"IGSA0P9F0013.jpg","path":"images/IGSA0P9F0013.webp","width":619,"height":529,"sha256":"6427c68171afe5f629506ccc26cbfef50e0e731514c21a14d5870e0ce9bc9ee3","sourceSha256":"bbbf3ef478c00b0d5d4aa4e5d5418f7042a969205785c4c88904e63dce0d8009","sourceBytes":35484},{"sourceName":"IGSA0P9F0014.jpg","path":"images/IGSA0P9F0014.webp","width":670,"height":482,"sha256":"ec5c6bab9cb9e39ac97231f98f50881a507f1fd21ab23e07ef926d15eda1c37e","sourceSha256":"1ef2a979de8ed76c14c9ff1d785dd0c9918a194b4f1200d4861ca88e865ed026","sourceBytes":26908},{"sourceName":"IGSA0P9F0036.jpg","path":"images/IGSA0P9F0036.webp","width":817,"height":446,"sha256":"f9c18068873167b7eb2704d11daa503d2b5193e142062d564fdc3eaed6ba4fed","sourceSha256":"aaabf6b93bc762a933becc4bb484d1d3666ded17bed9907b2f0f41948279be1f","sourceBytes":39638}],"references":[{"targetId":"AJPHSB0P9306002","anchor":"","title":"Снятие/установка панели приборов","available":true}],"sourceCounts":{"graphic":11,"table":1,"intxreftitleoff1":1},"searchText":"Удаление Отсоедините отрицательный провод от аккумулятора. Снимите центральное украшение панели приборов, выполнив следующие действия. Снимите перчаточный ящик. Снятие/установка панели приборов Заклейте показанные места малярной лентой (1). Освободите фиксатор центрального украшения панели приборов (1) изнутри отверстия перчаточного ящика. [a]: задняя часть автомобиля Вставьте средство для удаления смолы (1) в положение язычка, освобожденного на шаге c), и поднимите его в направлении стрелки, чтобы освободить язычок на центральном орнаменте панели приборов (2). Вставьте съемник в положения, показанные на рисунке, в порядке номеров («от 1» до «3») и подденьте, как в шаге d), чтобы освободить выступ на центральном украшении панели приборов (1). Потяните центральное украшение панели приборов (1) в направлении стрелки, чтобы снять его. Выверните винт (1) и снимите блок аудиосистемы/навигации (2), центральную крышку панели приборов (3) и центральную накладку панели приборов (4) вместе. Отсоедините разъем блока аудио/навигации. Выверните винт (1) и снимите заземляющий провод (2). Выверните винт (1) и снимите центральную крышку панели приборов (2). Выверните винт (1) и снимите накладку панели приборов (2). При необходимости выверните винт (1) и снимите кронштейн (2). Установка Установка выполняется в порядке, обратном снятию, но обратите внимание на следующие моменты. При креплении заземляющего провода (1) поместите клемму заземляющего провода напротив выступа (2) на кронштейне и затяните винт (3).","sourceSha256":"cf4e1748e5bd618853703effcfb030e617241bd6cf3929e9e2825f7447e31b59","sectionId":"9F","groupTitle":"Обслуживание","variant":null}
