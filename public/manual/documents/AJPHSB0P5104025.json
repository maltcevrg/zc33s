_W.png"},"children":[]},"\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"3","valign":"middle","align":"center"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n",{"tag":"symbol","attrs":{"name":"MACIRCLE_W","width":"5.006mm","height":"3.006mm","path":"symbols/MACIRCLE_W.png"},"children":[]},"\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"4","valign":"middle","align":"center"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n",{"tag":"symbol","attrs":{"name":"MACIRCLE_W","width":"5.006mm","height":"3.006mm","path":"symbols/MACIRCLE_W.png"},"children":[]},"\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"5","valign":"middle","align":"center"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"6","valign":"middle","align":"center"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"],"anchors":["AJPHSB0P5104025001","AJPHSB0P5104025002","AJPHSB0P5104025003","AJPHSB0P5104025004","AJPHSB0P5104025005","AJPHSB0P5104025006","AJPHSB0P5104025007","AJPHSB0P5104025008","AJPHSB0P5104025009","AJPHSB0P5104025010","AJPHSB0P5104025011"],"images":[],"references":[{"targetId":"AJPHSB0P5104001","anchor":"","title":"Проверка системы АКПП","available":true},{"targetId":"AJPHSB0P5106004","anchor":"","title":"Проверка жидкости АКПП","available":true},{"targetId":"AJPHSB0P5106005","anchor":"","title":"Замена жидкости АКПП","available":true},{"targetId":"AJPHSB0P5104008","anchor":"","title":"испытание на давление в линии","available":true},{"targetId":"AJPHSB0P5106007","anchor":"","title":"Снятие/установка корпуса клапана","available":true},{"targetId":"AJPHSB0P5106008","anchor":"","title":"Проверка соленоида","available":true},{"targetId":"AJPHSB0P5106009","anchor":"","title":"Снятие/установка TCM (контроллера АКПП)","available":true},{"targetId":"AJPHSB0P5106007","anchor":"","title":"Снятие/установка корпуса клапана","available":true}],"sourceCounts":{"table":3,"testgroup":5,"result":10,"action":10,"attention1":1,"attention3":1,"intxref":1,"intxreftitleoff1":7},"searchText":"Детали диагностики/предполагаемое местонахождение дефекта Детали диагноза Предполагаемое место дефекта P072A: Нейтраль застряла TCM (контроллер A/T) обнаружил нейтральное положение, когда сигнал переключателя передач находился в диапазоне D. (логика обнаружения 1D/C) Соленоиды гидравлического управления A, B и D Соленоид переключения передач № 1 и № 2 корпус клапана A/T (муфта переднего хода, муфта заднего хода и тормоз первого и заднего хода) TCM (контроллер АКПП) P073E: Сбой включения задней передачи. TCM (контроллер A/T) обнаружил нейтральное положение, когда сигнал переключателя передач находился в диапазоне R. (логика обнаружения 2D/C) P073F: Сбой включения 1-й передачи. TCM (контроллер A/T) обнаружил нейтральное положение, когда сигнал переключателя передач находился в диапазоне D. (логика обнаружения 2D/C) Процедура воспроизведения кода неисправности Несоблюдение следующих пунктов при проведении экзамена по вождению может привести к несчастному случаю. Выбирайте дороги с хорошей видимостью, например, с низкой интенсивностью движения, ровными дорогами и небольшим количеством зданий или перекрестков. Тест проводится двумя людьми, водителем и испытателем, причем водитель должен вести машину осторожно и учитывать окружающие условия. Выполняйте в условиях, соответствующих дорожным условиям (разрешенная скорость и т. д.). Если во время процедуры воспроизведения первым обнаруживается другой код неисправности, приоритет отдается диагностике неисправности другого кода неисправности. P072A / P073F Полностью прогрейте двигатель. Бегите в диапазоне D в течение 10 секунд. P073E Полностью прогрейте двигатель. Двигайтесь в диапазоне R в течение 10 секунд. Диагностика неисправностей Вы проводили «проверку системы A/T»?？ Перейдите к шагу 2. Проверка системы АКПП Осуществлять. Проверка жидкости АКПП Проверьте уровень жидкости АКПП и ее износ. Проверка жидкости АКПП Результаты проверки хорошие?？ Перейдите к шагу 3. Залейте или замените жидкость АКПП. Замена жидкости АКПП Проверка давления в линии Проверьте соответствующее давление в линии по таблице ниже. испытание на давление в линии Результаты проверки хорошие?？ Перейдите к шагу 4. Отремонтируйте или замените неисправные детали. Проверка соленоида Снимите корпус клапана. Снятие/установка корпуса клапана Проверьте соответствующий соленоид по таблице ниже. Проверка соленоида Результаты проверки хорошие?？ Перейдите к шагу 5. Замените корпус клапана. Проверка корпуса клапана Убедитесь, что каждый масляный канал в корпусе клапана не засорен. Результаты проверки хорошие?？ Осмотрите коробку передач (муфту переднего хода, муфту заднего хода, а также тормоз первой и задней передачи). Если результаты проверки хорошие, замените TCM (контроллер АКПП) и проверьте еще раз. Снятие/установка TCM (контроллера АКПП) Очистите или замените корпус клапана. Снятие/установка корпуса клапана Шаг 3 Таблица проверки давления в трубопроводе DTC Гидравлическое смотровое отверстие C1 C3 B2 P072A P073E P073F Шаг 4. Стол для проверки соленоидов. DTC Соленоид переключения передач №1 Соленоид переключения передач №2 Соленоид гидравлического управления A Соленоид гидравлического управления B Соленоид гидравлического управления D P072A P073E P073F","sourceSha256":"eafc221cec48018398ec198cc368e90a39db8bc70c1031f55913ae24c70d4481","sectionId":"51","groupTitle":"Диагностика","variant":null}
