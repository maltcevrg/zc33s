ие коды DTC не обнаруживаются: U0073, U0100.\n"]},"\n"]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nПолностью прогрейте двигатель.\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nСовершите поездку 5 раз по 1 минуте со скоростью 50 км/ч или выше в диапазоне D.\n"]},"\n"]},"\n"]},"\n",{"tag":"servinfosub","attrs":{"id":"AJPHSB0P5104037003"},"children":["\n",{"tag":"title","attrs":{},"children":["\nДиагностика неисправностей\n"]},"\n",{"tag":"diag","attrs":{"type":"test","id":"AJPHSB0P5104037004"},"children":["\n",{"tag":"testgroup","attrs":{"id":"AJPHSB0P5104037005"},"children":["\n",{"tag":"question","attrs":{},"children":["\nВы проводили «проверку системы A/T»?？\n"]},"\n",{"tag":"result","attrs":{"type":"yes"},"children":[]},"\n",{"tag":"action","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nПерейдите к шагу 2.\n"]},"\n"]},"\n",{"tag":"result","attrs":{"type":"no"},"children":[]},"\n",{"tag":"action","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n",{"tag":"intxref","attrs":{"refid":"AJPHSB0P5104001","targetTitle":"Проверка системы АКПП","available":true},"children":["Проверка системы АКПП"]},"\n Осуществлять.\n"]},"\n"]},"\n"]},"\n",{"tag":"testgroup","attrs":{"id":"AJPHSB0P5104037006"},"children":["\n",{"tag":"title","attrs":{},"children":["\nПроверка жидкости АКПП\n"]},"\n",{"tag":"test1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nПроверьте уровень жидкости АКПП и ее износ. \n",{"tag":"intxreftitleoff1","attrs":{"refid":"AJPHSB0P5106004","targetTitle":"Проверка жидкости АКПП","available":true},"children":["Проверка жидкости АКПП"]},"\n"]},"\n"]},"\n",{"tag":"question","attrs":{},"children":["\nРезультаты проверки хорошие?？\n"]},"\n",{"tag":"result","attrs":{"type":"yes"},"children":[]},"\n",{"tag":"action","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nПерейдите к шагу 3.\n"