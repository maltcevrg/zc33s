[{"sourceName":"IHSB0PA10004.swf","path":"images/IHSB0PA10004.webp","width":1382,"height":1364,"sha256":"4771ebaf7b6bb217eecbaabff3c44b2584682e4d83de95da2468214e6dbb0186","sourceSha256":"1cc5cd419b869a8f562696192f8fa89bf8b7e55461f5ce94f6da6de342914fbd","sourceBytes":198979}],"references":[{"targetId":"AJPHSB0PA126007","anchor":"","title":"Нейтральное положение, проверка SW","available":true},{"targetId":"AJPHSB0P1326001","anchor":"","title":"Снятие/установка ECM","available":false},{"targetId":"AJPHSB0P1336001","anchor":"","title":"Снятие/установка ECM","available":true},{"targetId":"AJPHSB0PA126006","anchor":"","title":"Нейтральное положение Снятие/установка SW","available":true}],"sourceCounts":{"graphic":1,"table":2,"testgroup":2,"result":4,"action":4,"intxreftitleoff1":4},"searchText":"Условия обнаружения DTC и возможные места неисправности Условие обнаружения Возможное место неисправности P081D: Неисправность нейтрального SW. Напряжение сигнальной цепи нейтрального положения SW в течение определенного периода времени оставалось вне стандартного диапазона. Нейтральное положение SW проводка/разъем Нейтральное положение SW ECM принципиальная схема [A]: Разъем ECM (спецификация K14C) (вид стрелки: [a]) A1: Сигнальная линия SW нейтрального положения 1. Нейтральное положение SW [B]: Разъем ECM (K12C: без упора холостого хода) (вид стрелки: [a]) A2: Нейтральное положение SW заземляющий провод 2. ECM Процедура воспроизведения кода неисправности Включите зажигание. Диагностика неисправностей Проверка сигнального провода нейтрального положения SW и провода заземления нейтрального положения SW Выключите зажигание и отсоедините разъем SW нейтрального положения и разъем ECM (E01/E02). Проверьте клеммные соединения разъема SW нейтрального положения и разъема ECM. Если клеммное соединение хорошее, проверьте сигнальный провод переключателя нейтрального положения (A1) и провод заземления переключателя нейтрального положения (A2) на наличие следующих элементов. Сопротивление сигнального провода нейтрального положения SW и заземляющего провода нейтрального положения SW составляет 1 Ом или менее. Нейтральное положение SW Сопротивление изоляции между сигнальным проводом, заземляющим проводом нейтрального положения SW и массой кузова бесконечно. Нейтральное положение SW Нейтральное положение разъема SW Сигнальный провод в нейтральное положение SW Сопротивление изоляции между клеммами заземляющего провода бесконечно. Когда зажигание включено, напряжение сигнального провода переключателя нейтрального положения и провода заземления переключателя нейтрального положения составляет от 0 до 1 В. Результаты проверки хорошие? Перейдите к шагу 2. Отремонтируйте или замените неисправную проводку. Нейтральное положение, проверка SW Проверьте нейтральное положение SW. Нейтральное положение, проверка SW Результаты хорошие? Замените ECM и проверьте еще раз. Технические характеристики K12C: Снятие/установка ECM Технические характеристики K14C: Снятие/установка ECM Замените SW нейтрального положения. Нейтральное положение Снятие/установка SW","sourceSha256":"998095f30599a33c1072d68de4d13728136e3d3bd85e2236ae1d69f336c1929c","sectionId":"A1","groupTitle":"Диагностика","variant":"адаптивный круиз-контроль"}
