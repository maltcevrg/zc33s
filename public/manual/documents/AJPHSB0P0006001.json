height":298,"sha256":"95f66b8ab6fd81d55ba0c02c192d2f14722b9d824619758f9bb199165db3345c","sourceSha256":"a97cc0dae704bd9a1cdf299a0389798eba3dfd452ee92b9ae08b23a17363cbe7","sourceBytes":18832},{"sourceName":"I8G001000002.swf","path":"images/I8G001000002.webp","width":675,"height":467,"sha256":"fb579b0c08077f7fdbd90892ec3d25763506571bd69659adbbe35ff59022bb73","sourceSha256":"aaaafa1f926638f86b1ef8b0ff3cc718f12107944f1cc309345857351a3a5c7f","sourceBytes":22702},{"sourceName":"I8G001000003.swf","path":"images/I8G001000003.webp","width":722,"height":463,"sha256":"29f9be5d4b9e0ad9b4bbb3968780c42b37c251d7052bb83a14b3f3db740c8c92","sourceSha256":"63f299c6dfac7a800bbf3071af5f0bf966d7b884b4629e37bf85e824945eb8c8","sourceBytes":29681},{"sourceName":"I8G001000004.swf","path":"images/I8G001000004.webp","width":726,"height":449,"sha256":"2409cd15e7db31e9d33ae67e4e10e69845b5dd88f47c7fad64a9fa105b9df1f9","sourceSha256":"3607a89a849c17ece94a57649a886094d20cd0e339bcd7eda74e41fc6c9b3560","sourceBytes":30667},{"sourceName":"I8G001000005.swf","path":"images/I8G001000005.webp","width":719,"height":364,"sha256":"9cafe22e8433623023b39921ae45390fe8e6df897940e35e57831da8fa6833a5","sourceSha256":"9853b5513b3cdeb654fef0da03046b90554df079be0f69f04e3598500d7d68de","sourceBytes":23763},{"sourceName":"I8G001000006.swf","path":"images/I8G001000006.webp","width":723,"height":378,"sha256":"5dad44e31ad88fd45703fc226ee828abb48269365f6638fb66938b1c3ce1083a","sourceSha256":"bd11001b5bb084185d9a5bdc21bffc2a95d7e8486822b189b464670ac6481286","sourceBytes":29985},{"sourceName":"I8G001000007.swf","path":"images/I8G001000007.webp","width":712,"height":459,"sha256":"ff5901cd03d3b2a9fc727393b7ff80d0eec19a2bf88664cdcb75eb6db18acab0","sourceSha256":"85d4866341fe7e43acca2dc2d196b173b584d429edf6a4e109193bf66c5a52d8","sourceBytes":31330},{"sourceName":"I8G001000008.swf","path":"images/I8G001000008.webp","width":712,"height":459,"sha256":"8e3a4cc745f146382c819e094a224da90eb7c15eab05804119fdd04f4e572519","sourceSha256":"d57a5c78cf5e8d9f72c3ae4a4c4e93ddc69a0780ddd966fffed43f56ccb12e57","sourceBytes":31486},{"sourceName":"IBD30P000001.swf","path":"images/IBD30P000001.webp","width":745,"height":418,"sha256":"45b765ae6dd6bc9b8d90109816c1026eca0f4da7bfe4abdcc5a50b34afacabaa","sourceSha256":"cf70871ce458634927fea39b77edd402e508ee73679981cdd40a4d8d3b2bd34b","sourceBytes":42137}],"references":[],"sourceCounts":{"graphic":9,"table":4,"attention4":2},"searchText":"Подключение или отсоединение разъема при включенном зажигании может привести к повреждению электрической цепи. При подсоединении или отсоединении разъема выключайте зажигание. Проверка разъема Проверьте состояние подключения разъема и эффективность блокировки. Отсоедините разъем и осмотрите клеммы на предмет деформации, разъединения, засоров, коррозии и т. д. Чтобы проверить контактное давление клеммы, подготовьте ту же клемму, что и вилка, вставьте ее в гнездовую клемму и проверьте посадку. Проверка отключения Распределение напряжения при нормальной работе делится на напряжение источника питания (12 В, 5 В и т. д.) и примерно 0 В на нагрузке (3). [a]: Примерно 12 В 1. предохранитель [b]: Примерно 0 В 2. SW При проверке отключений в системе электропитания и системе заземления место повреждения (4) можно определить путем проверки напряжения. [a]: Примерно 12 В 2. разъем [b]: Примерно 0 В 3. лампа 1. контроллер Хотя можно проверить сигнальную систему, проверив напряжение (на основе формы сигнала), более эффективно проверить непрерывность напрямую. [a]: 1 МОм или более 2. лампа [b]: Примерно 0 Ом 3. Неисправная часть 1. контроллер Проверка замыкания на землю (3) Если жгут имеет короткое замыкание на землю (замыкание на землю), проверьте целостность (изоляцию) с землей. [a]: 1 МОм или более 1. контроллер [b]: Примерно 0 Ом 2. лампа Проверка выходного напряжения датчика Чтобы проверить выходное напряжение датчика, используйте сервисный провод (3) между разъемом датчика (2) и разъемом (1), подключенным к датчику (4), и подключите его, как показано на схеме ниже. Обратите внимание, что сервисный провод, подключенный к сигнальной клемме датчика, имеет ответвление, поэтому его можно измерить вольтметром. Подключение сервисных проводов без изоляции каждой клеммы (изоляционной лентой (5) и т. д.) может привести к короткому замыканию между клеммами. Изолируйте каждую клемму изоляционной лентой и т. д. и подсоедините сервисный провод.","sourceSha256":"ff2267f55d4ec4e9c32c44a17e8507abffff4424ad750d350e170072c49cdb60","sectionId":"00","groupTitle":"Обслуживание","variant":null}
