05bed81ada0fb7ab1527afc472f4200e33d41d60922","sourceSha256":"b2ae515eca1456818b966cf1bd3caa99a880fd846247cc57f63e19b839476f5f","sourceBytes":30991},{"sourceName":"IBK80P190011.swf","path":"images/IBK80P190011.webp","width":594,"height":443,"sha256":"747a1de75da1ddee6efaeb05e38dfb01bf23640b00c6ec9c2b7883904b5e10ef","sourceSha256":"6508601ab0e1918c4bfd024965f6dd6b3c56dc09ec11434aac32e95fcfe600dd","sourceBytes":47139},{"sourceName":"IBK80P190012.swf","path":"images/IBK80P190012.webp","width":641,"height":572,"sha256":"217e423e061bc89fc363534b4963277b2efdffe0c8a8032d918fb54e3301a8a5","sourceSha256":"892742746219197f7b6eb548856792d148a2475c9a7d2ce6ed02314d51c06caa","sourceBytes":63946},{"sourceName":"I8C50B190020.swf","path":"images/I8C50B190020.webp","width":695,"height":569,"sha256":"da38cdd67a052a71f398753e8633a8b46a8a762606da40ff9b7ccbf025d9b5fc","sourceSha256":"a0ff45be62f42403b1dc6e5c6146260ba06922f4f399f1d59f9898f763aef150","sourceBytes":58328},{"sourceName":"I8C50B190021.swf","path":"images/I8C50B190021.webp","width":988,"height":965,"sha256":"a2b0d6927ad21a153db968fc4185f5869ceafa8308759c9f16239de213023247","sourceSha256":"9d35f9dc8f513e68f86f4273cccea42cf2493b75a6ae55ce55dc4b7676161527","sourceBytes":41300},{"sourceName":"I8C50B190022.swf","path":"images/I8C50B190022.webp","width":495,"height":668,"sha256":"4eb41efbc94ff5b976bae69a07bc7decbc538d70e6406d485612cab5ca6fe5ca","sourceSha256":"a4ddae68e7023bd6ef0aaba9e0185d8aa6a9c3d9066b9426c07aaa1228fa811d","sourceBytes":46919},{"sourceName":"IBK80P190013.swf","path":"images/IBK80P190013.webp","width":540,"height":454,"sha256":"2eca15065a64c702546c4533efed240843226b186f2ab53d5c8abe613016117e","sourceSha256":"6ec3d8dac86ddc60ef27eec539695a30a6c66350382a5ef5795fb7c37e86a64d","sourceBytes":32589}],"references":[{"targetId":"AJPHSB0P1936002","anchor":"","title":"Начало снятия/установки двигателя","available":true},{"targetId":"AJPHSB0P1936005","anchor":"","title":"Начинаем осмотр двигателя","available":true},{"targetId":"AJPHSB0P1936005","anchor":"","title":"Начинаем осмотр двигателя","available":true}],"sourceCounts":{"graphic":22,"table":1,"torqueitem":4,"materialitem":4,"attention3":1,"intxrefpoff":2,"intxreftitleoff1":1},"searchText":"Снятие/установка пускового двигателя: K14C Разложение Поместите совпадающие метки (1) и (2) на стартер. Снимите гайку подводящего провода (1) и снимите подводящий провод (2) с магнита SW (3). Выверните винт SW магнита (4) и снимите SW магнита (1), плунжер (3) и пружину (2). Если возникла проблема с программным обеспечением магнита, замените его блоком программного обеспечения магнита. Отверните болт заднего кронштейна (1) и снимите вилку в сборе (3) с корпуса якоря в сборе (2). Снимите набивку (2) и планетарную передачу (1). Снимите уплотнительную резинку (1) и пластину (2). Снимите вал шестерни в сборе (1) и рычаг привода шестерни (2) вместе. Переместите стопорное кольцо шестерни (3) в сторону обгонной муфты (4) и снимите стопорное кольцо (2) с помощью плоскогубцев (5). Снимите стопорное кольцо шестерни, обгонную муфту и внутреннюю шестерню (1) с вала шестерни. Выверните винт держателя щетки (1) и снимите задний кронштейн (2). Снимите щетку в сборе (3) с вилки в сборе (4). Снимите якорь (1) с траверсы (2). Снимите щетку (1) и пружину щетки (2) с держателя щеток (3). Сборка Начало проверки двигателя: K14C Прикрепите пружину щетки (2) и щетку (1) к держателю щеток (3). Прикрепите якорь (2) к траверсе (4). Прикрепите узел щетки (1) к якорю, нажимая на щетку (3) в направлении стрелки. Прикрепите задний кронштейн (1) к держателю щеток (3) и затяните винт держателя щеток (2) с указанным моментом затяжки. винт держателя щетки a 3.5 Нм Нанесите смазку в места, показанные на рисунке, и прикрепите обгонную муфту (2) и внутреннюю шестерню (3) к валу шестерни (1). “A” смазка 99000–25011 Сузуки Супер Смазка А Прикрепите новое стопорное кольцо шестерни (2) и новое стопорное кольцо (3) к валу шестерни (1), как показано на рисунке. 4. обгонная муфта Нанесите смазку на рычаг привода шестерни (2) и прикрепите его к валу шестерни в сборе (1). “A” смазка 99000–25011 Сузуки Супер Смазка А Присоедините вал шестерни в сборе и рычаг привода шестерни к корпусу якоря в сборе (3). Совместите выемку на уплотнении (1) с отверстием под болт (3) в корпусе якоря в сборе и установите. Прикрепите пластину (5) и резиновое уплотнение (4) к корпусу якоря в сборе. Нанесите смазку на планетарную передачу (2) и прикрепите ее к валу шестерни. “A” смазка 99000–25011 Сузуки Супер Смазка А Совместите совпадающие метки (3), сделанные перед разборкой, и прикрепите вилку в сборе (4) к корпусу якоря в сборе (2). Затяните болт заднего кронштейна (1) указанным моментом затяжки. болт заднего кронштейна a 6.0 Нм Нанесите смазку на поршень. “A” смазка 99000–25011 Сузуки Супер Смазка А Прикрепите пружину (2) и плунжер (3) к магниту SW (1). Убедитесь, что кончик рычага привода шестерни входит в плунжер, совместите метки, сделанные перед разборкой, прикрепите магнит SW к корпусу якоря в сборе (5) и затяните винт SW магнита (4) с указанным моментом затяжки. Магнитный винт SW a 6.0 Нм Подсоедините подводящий провод (1) к клемме М (3) и затяните гайку подводящего провода (2) с указанным моментом затяжки. гайка подводящего провода a 10 Нм Проверьте работу стартера. Начинаем осмотр двигателя","sourceSha256":"ba7224f0c564bfaa6c49f27fb7a3e3a9ab756ff3aeefddf7c0195081a11e99a4","sectionId":"1I","groupTitle":"Обслуживание","engine":"K14C"}
