name":"IFRA0B510040.swf","width":"88.000mm","height":"53.812mm","path":"images/IFRA0B510040.webp","pixelWidth":792,"pixelHeight":490},"children":[]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nПодсоедините выпускной шланг радиатора к радиатору. \n",{"tag":"intxreftitleoff1","attrs":{"refid":"AJPHSB0P1616001","targetTitle":"Схема конфигурации системы охлаждения","available":false},"children":["Схема конфигурации системы охлаждения"]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nПодсоедините разъем TCM (контроллер АКПП) и зажмите его.\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nПодключите выбранный кабель. \n",{"tag":"intxreftitleoff1","attrs":{"refid":"AJPHSB0P5106052","targetTitle":"Выберите удаление/установку кабеля","available":true},"children":["Выберите удаление/установку кабеля"]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nЗалейте охлаждающую воду. \n",{"tag":"intxreftitleoff1","attrs":{"refid":"AJPHSB0P1616005","targetTitle":"наполнение охлаждающей жидкостью","available":false},"children":["наполнение охлаждающей жидкостью"]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nУстановите аккумулятор и лоток для аккумулятора. \n",{"tag":"intxreftitleoff1","attrs":{"refid":"AJPHSB0P1A16002","targetTitle":"Снятие/установка аккумулятора","available":false},"children":["Снятие/установка аккумулятора"]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nПри необходимости введите жидкость АКПП. \n",{"tag":"intxreftitleoff1","attrs":{"refid":"AJPHSB0P5106005","targetTitle":"Замена жидкости АКПП","available":true},"children":["Замена жидкости АКПП"]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nУстановите нижнюю крышку двигателя и нижнюю боковую крышку двигателя.\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nПри замене блока TCM или коробки передач на новый выполните «Запись данных TCM». (Обратитесь к руководству по эксплуатации SEPS (системы программирования ECU Suzuki)).\n"]},"\n",{"tag":"attention3","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nВ зависимости от технических характеристик в TCM пополнения могут не быть записаны данные. Продукты, в которые не записаны данные, поставляются с примечанием о том, что «Этот продукт не будет работать, пока не будет написано программное обеспечение». Для продуктов, в которые не записаны данные, запишите данные TCM.\n"]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n",{"tag":"intxref","attrs":{"refid":"AJPHSB0P5106001","targetTitle":"Удаление значения обучения TCM (контроллера АКПП)","available":true},"children":["Удаление значения обучения TCM (контроллера АКПП)"]},"\n— выполните. (При замене АКПП в сборе) \n",{"tag":"button","attrs":{"type":"activetest","code":"AT/CVT,ST005"},"children":[]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n",{"tag":"intxref","attrs":{"refid":"AJPHSB0P5106003","targetTitle":"Калибровка нейтрального положения","available":true},"children":["Калибровка нейтрального положения"]},"\n — выполните. \n",{"tag":"button","attrs":{"type":"utility","code":"AT/CVT,ST004,AT-06"},"children":[]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n",{"tag":"intxref","attrs":{"refid":"AJPHSB0P5106002","targetTitle":"Настройка значения обучения TCM (контроллера АКПП)","available":true},"children":["Настройка значения обучения TCM (контроллера АКПП)"]},"\n— выполните. (При замене АКПП в сборе)\n"]},"\n"]},"\n"]},"\n"],"anchors":["AJPHSB0P5106016001","AJPHSB0P5106016002","T5A014","T5A015","T5A01