ourceSha256":"f143ca3aba87ada1b6a8692cb7c05a8537fb3b701b590789b4ab885fa635b2bd","sourceBytes":56392},{"sourceName":"IGSA0P940029.jpg","path":"images/IGSA0P940029.webp","width":824,"height":536,"sha256":"fede4486d0b85c5b22714db5348b6ff557c90a436ea854a20515b411a1d93c39","sourceSha256":"a31fde821a4ca8bac546866ecb046267ac9ee5d44fcc55299966e45d954c4b34","sourceBytes":24811},{"sourceName":"IHSB0P940007.jpg","path":"images/IHSB0P940007.webp","width":767,"height":608,"sha256":"413f553a05ab066d470cb670c9210f3e8fc243c20d7498dc59a92d0429fce7b9","sourceSha256":"8fd6b393bb6d7189a1cd09b7c24fd9c04a92ca5ef2fe21939bd335a602557fca","sourceBytes":19870}],"references":[{"targetId":"AJPHSB0P9806005","anchor":"","title":"Снятие/установка декоративной отделки капота","available":true},{"targetId":"AJPHSB0P9206026","anchor":"","title":"Снятие/установка верхнего стоп-сигнала","available":true},{"targetId":"AJPHSB0P9206026","anchor":"","title":"Снятие/установка верхнего стоп-сигнала","available":true},{"targetId":"AJPHSB0P9206026","anchor":"","title":"Снятие/установка верхнего стоп-сигнала","available":true},{"targetId":"AJPHSB0P9206026","anchor":"","title":"Снятие/установка верхнего стоп-сигнала","available":true}],"sourceCounts":{"graphic":10,"intxref":1,"intxrefpoff":1,"intxreftitleoff1":3},"searchText":"передний Снятие Снимите верхнюю боковую накладку капота и верхнюю центральную накладку капота. Снятие/установка декоративной отделки капота Снимите форсунку омывателя передней части кузова (2), нажимая на выступ (1). Установка Установка производится в порядке, обратном снятию. Задняя часть (без спойлера задней двери) Снятие Снимите верхний стоп-сигнал. Снятие/установка верхнего стоп-сигнала Откройте заднюю дверь и снимите заглушку (1) с внутренней панели задней двери. Снимите шланг омывателя (1), потянув его в направлении стрелки. Снимите форсунку омывателя заднего стекла (2), нажимая на выступ (1). Установка Снятие/установка верхнего стоп-сигнала Для установки выполните процедуру снятия в обратном порядке. Задняя часть (спойлер задней двери) Снятие Снимите верхний стоп-сигнал. Снятие/установка верхнего стоп-сигнала Удалите Эптширу (1). Откройте заднюю дверь и снимите заглушку (1) с внутренней панели задней двери. Снимите шланг омывателя (1), потянув его в направлении стрелки. Нажимая на выступ (1), нажмите на форсунку заднего омывателя (2) в направлении стрелки (а), чтобы снять ее. Установка Для установки выполните процедуру снятия в обратном порядке, но обратите внимание на следующие моменты. Пропустите шланг насадки омывателя (1), как показано на рисунке. Вставьте шланг омывателя в панель задней двери так, чтобы соединительная часть (1) шланга омывателя находилась сверху, когда задняя дверь открыта. Снятие/установка верхнего стоп-сигнала Установите верхний стоп-сигнал, как описано в разделе «Установка».","sourceSha256":"4c1682dfb21c7f8a2ed8100fee25afb4c8bd4e96432d76632d646d371246d52f","sectionId":"94","groupTitle":"Обслуживание","variant":null}
