8B294"],"images":[{"sourceName":"IGSA0P822012.swf","path":"images/IGSA0P822012.webp","width":1591,"height":763,"sha256":"2d941c9d1569d413b43798a6b3150e05b4fae8d7d21576f595b071eba7eaab55","sourceSha256":"77a5d1f9e3afa0b783003198c800c2d408574b7421ff11c1083c901f00a5fc4d","sourceBytes":60663},{"sourceName":"IGSA0P822013.swf","path":"images/IGSA0P822013.webp","width":1260,"height":230,"sha256":"07cbef3e6aa329976f3a7ae4619e45125f500fa3a0b97606c5c116b2ecdfe465","sourceSha256":"268c790ac8c2dfe8eff3a263eb617f090875208562eca512a5915ace02a8c04a","sourceBytes":32666}],"references":[{"targetId":"AJPHSB0P8224001","anchor":"","title":"Проверка системы подушек безопасности","available":true},{"targetId":"AJPHSB0P8226003","anchor":"","title":"Как освободить короткий штифт","available":true},{"targetId":"AJPHSB0P8226004","anchor":"","title":"Снятие/установка контроллера подушек безопасности","available":true},{"targetId":"AJPHSB0P8226003","anchor":"","title":"Как освободить короткий штифт","available":true}],"sourceCounts":{"graphic":2,"table":2,"testgroup":3,"result":6,"action":6,"servicetoolitem":2,"intxref":1,"intxreftitleoff1":3},"searchText":"Детали диагностики/предполагаемое местонахождение дефекта Детали диагноза Предполагаемое место дефекта B1068-15: Неисправность системы надувания боковой подушки безопасности водителя. Цепь модуля накачки со стороны водителя замкнута на источник питания. Цепь модуля накачки со стороны водителя/пассажира контроллер подушек безопасности B1069-15: Неисправность системы надувания боковой подушки безопасности пассажира. Цепь модуля накачки со стороны пассажира замкнута на источник питания. принципиальная схема [A]: Разъемы «Q104» и «Q105» (вид стрелки: [a]) A3: Выходная цепь сигнала развертывания модуля накачки со стороны пассажира 4. короткая булавка [B]: Разъемы «L384» и «L385» (вид стрелки: [a]) A4: Цепь заземления сигнала развертывания модуля накачки со стороны пассажира 5. напольная обвязка [C]: Разъем «L05» (вид стрелки: [a]) 1. Модуль поддува со стороны водителя 6. ремни безопасности сиденья A1: Выходная цепь сигнала развертывания модуля накачивания со стороны водителя 2. Модуль поддува со стороны пассажира A2: Цепь заземления сигнала развертывания модуля накачки со стороны водителя 3. контроллер подушек безопасности Диагностика неисправностей Вы проводили «проверку системы подушек безопасности»?？ Перейдите к шагу 2. Проверка системы подушек безопасности: 10 каналов пердеть. Проверка цепи модуля бокового накачивания Выключите зажигание. Отсоедините разъем «Q104» или «Q105» от модуля накачивания со стороны водителя/пассажира. Отсоедините разъем «L05» от контроллера подушек безопасности. Освободите короткий штифт на разъеме контроллера подушки безопасности. Как освободить короткий штифт Выполните следующие проверки. Напряжение между цепями «А1» и «А2» и массой кузова при включении зажигания (DTC B1068-15): 0 В Напряжение между цепями «А3» и «А4» и массой кузова при включении зажигания (DTC B1069-15): 0 В 09932–76010 Результаты проверки хорошие?？ Замените контроллер подушек безопасности и еще раз проверьте коды DTC. Снятие/установка контроллера подушек безопасности Перейдите к шагу 3. Проверка цепи напольного жгута Выключите зажигание. Снимите разъем «L384» или «L385» с ремня безопасности сиденья. Освободите короткий штифт на разъеме контроллера подушки безопасности. Как освободить короткий штифт Выполните следующие проверки. Напряжение между цепями «А1» и «А2» и массой кузова при включении зажигания (DTC B1068-15): 0 В Напряжение между цепями «А3» и «А4» и массой кузова при включении зажигания (DTC B1069-15): 0 В 09932–76010 Результаты проверки хорошие?？ Замените ремни сиденья. Замените напольную обвязку.","sourceSha256":"c8b74e6202ea7976d6555109c0dfd07cc5b7137dcfc30a10648d709889d42c81","sectionId":"82","groupTitle":"Диагностика","variant":"10ch"}
