256":"a47d3a6f8a53afea29ee4845cee60750a13a57fb09476f208e50ab072ffa917e","sourceSha256":"cfa2e89e28588a52bb032d273606ffa5a7f81259729be6a3eec208ed014113e5","sourceBytes":37924}],"references":[{"targetId":"AJPHSB0P8214001","anchor":"","title":"Проверка системы подушек безопасности","available":true},{"targetId":"AJPHSB0P8216003","anchor":"","title":"Как освободить короткий штифт","available":true},{"targetId":"AJPHSB0P8216006","anchor":"","title":"Снятие/установка модуля накачки сиденья водителя","available":true},{"targetId":"AJPHSB0P8216003","anchor":"","title":"Как освободить короткий штифт","available":true},{"targetId":"AJPHSB0P8216004","anchor":"","title":"Снятие/установка контроллера подушек безопасности","available":true},{"targetId":"AJPHSB0P6206003","anchor":"","title":"Снятие/установка контактной катушки","available":true}],"sourceCounts":{"graphic":2,"table":2,"testgroup":3,"result":6,"action":6,"servicetoolitem":2,"intxref":1,"intxreftitleoff1":5},"searchText":"Детали диагностики/предполагаемое местонахождение дефекта Детали диагноза Предполагаемое место дефекта B1060-14: Неисправность на массу системы накачивания подушки безопасности водителя. Цепь модуля накачки сиденья водителя замкнута на массу. Цепь модуля накачки сиденья водителя контактная катушка контроллер подушек безопасности B1060-15: Короткое замыкание системы накачивания подушки безопасности водителя Цепь модуля накачки сиденья водителя замкнута на цепь питания. принципиальная схема [A]: Разъем «G347» (вид стрелки: [a]) A1: Выходная цепь сигнала развертывания модуля накачки сиденья водителя 3. контроллер подушек безопасности [B]: Разъем «G346» (вид стрелки: [a]) A2: Цепь заземления сигнала развертывания модуля накачки сиденья водителя 4. короткая булавка [C]: Разъем «S121» (вид стрелки: [a]) 1. модуль накачки сиденья водителя 5. жгут панели приборов [D]: Разъем «G11» (вид стрелки: [a]) 2. контактная катушка Диагностика неисправностей Вы проводили «проверку системы подушек безопасности»?？ Перейдите к шагу 2. Проверка системы подушек безопасности: 4 канала пердеть. Проверка цепи модуля накачки сиденья водителя Выключите зажигание. Снимите разъем «G346» или «G347» с контактной катушки. Отсоедините разъем «G11» от контроллера подушек безопасности. Освободите короткий штифт на разъеме контроллера подушки безопасности. Как освободить короткий штифт Выполните следующие проверки. Сопротивление между цепями «A1» и «A2» с массой кузова (DTC B1060-14): бесконечное. Напряжение между цепями «А1» и «А2» и массой кузова при включении зажигания (DTC B1060-15): 0 В 09932–76010 Результаты проверки хорошие?？ Перейдите к шагу 3. Замените жгут панели приборов. Проверка цепи контактной катушки Выключите зажигание. Подсоедините разъем контактной катушки «G346» или «G347». Снимите модуль накачки сиденья водителя с рулевой колонки. Снятие/установка модуля накачки сиденья водителя Освободите короткий штифт на разъеме контроллера подушки безопасности. Как освободить короткий штифт Выполните следующие проверки. Сопротивление между цепями «A1» и «A2» с массой кузова (DTC B1060-14): бесконечное. Напряжение между цепями «А1» и «А2» и массой кузова при включении зажигания (DTC B1060-15): 0 В 09932–76010 Результаты проверки хорошие?？ Замените контроллер подушек безопасности и еще раз проверьте коды DTC. Снятие/установка контроллера подушек безопасности Замените контактную катушку. Снятие/установка контактной катушки","sourceSha256":"ac07e9e49a2f357e660c845e09d22a91f0440d5dbef247b147f85b8623e1e374","sectionId":"82","groupTitle":"Диагностика","variant":"4ch"}
