03f64cebb3d118e44827a0943bf33278","sourceBytes":33942},{"sourceName":"IGSB0A822060.swf","path":"images/IGSB0A822060.webp","width":713,"height":490,"sha256":"38056a6ea3e1c0baa7e7aff3d1e8eed6dc6160d781e5791e8351c86e5c25e300","sourceSha256":"082b2180f93738f3d4be12c654cb7609e2d8dff30d384d97e964cc62f772a22f","sourceBytes":55800}],"references":[{"targetId":"AJPHSB0P8224001","anchor":"","title":"Проверка системы подушек безопасности","available":true},{"targetId":"AJPHSB0P8224005","anchor":"","title":"Дисплей кодов неисправности","available":true},{"targetId":"AJPHSB0P8226014","anchor":"","title":"Снятие и установка преднатяжителя ремня безопасности заднего сиденья.","available":true},{"targetId":"AJPHSB0P8226003","anchor":"","title":"Как освободить короткий штифт","available":true},{"targetId":"AJPHSB0P8226004","anchor":"","title":"Снятие/установка контроллера подушек безопасности","available":true},{"targetId":"AJPHSB0P8226003","anchor":"","title":"Как освободить короткий штифт","available":true}],"sourceCounts":{"graphic":3,"table":2,"testgroup":4,"result":8,"action":8,"servicetoolitem":4,"intxref":1,"intxreftitleoff1":5},"searchText":"Детали диагностики/предполагаемое местонахождение дефекта Детали диагноза Предполагаемое место дефекта B1071-1B: Отсоединение системы преднатяжителя левого заднего сиденья Сопротивление цепи преднатяжителя левого ремня безопасности заднего сиденья выше стандартного значения. Цепь преднатяжителя левого/правого ремня безопасности заднего сиденья Преднатяжитель ремня безопасности левой/правой стороны заднего сиденья контроллер подушек безопасности B1072-1B: Отсоединение системы преднатяжителя правого заднего сиденья Сопротивление цепи преднатяжителя правого ремня безопасности заднего сиденья выше стандартного значения. принципиальная схема [A]: Разъемы «L275» и «L276» (вид стрелки: [a]) A3: Цепь сигнала массы левого преднатяжителя ремня безопасности заднего сиденья 4. короткая булавка [B]: Разъем «G343» (вид стрелки: [a]) A4: Выходная цепь сигнала преднатяжителя левого ремня безопасности заднего сиденья 5. жгут панели приборов [C]: Разъем «G12» (вид стрелки: [a]) 1. Преднатяжитель правого ремня безопасности заднего сиденья 6. напольная обвязка A1: Цепь сигнала массы правого преднатяжителя ремня безопасности заднего сиденья 2. Преднатяжитель левого ремня безопасности заднего сиденья A2: Выходная цепь сигнала преднатяжителя правого ремня безопасности заднего сиденья 3. контроллер подушек безопасности Диагностика неисправностей Вы проводили «проверку системы подушек безопасности»?？ Перейдите к шагу 2. Проверка системы подушек безопасности: 10 каналов пердеть. Проверка преднатяжителя ремня безопасности Выключите зажигание. Убедитесь, что разъем «L275» или «L276» правого/левого преднатяжителя ремня безопасности заднего сиденья надежно подсоединен. Снимите разъем «L275» или «L276» с правого/левого заднего преднатяжителя ремня безопасности. Подсоедините «STEERING WHEEL» (1) специальных инструментов (А) и (В) к разъему «L275» или «L276». （A） 09932–76010 （B） 09932–78310 Проверьте DTC контроллера подушек безопасности. Дисплей кодов неисправности Обнаружен ли DTC B1071-1B или 1072-1B при включении зажигания?？ Перейдите к шагу 3. Замените неисправный преднатяжитель ремня безопасности. Снятие и установка преднатяжителя ремня безопасности заднего сиденья. Проверка цепи преднатяжителя ремня безопасности Выключите зажигание. Убедитесь, что разъем «G12» надежно подсоединен к контроллеру подушек безопасности. Отсоедините разъем «G12» от контроллера подушек безопасности. Освободите короткий штифт на разъеме контроллера подушки безопасности. Как освободить короткий штифт Выполните следующие проверки. Сопротивление между клеммами «G12-21» и «L276-2», а также между клеммами «G12-20» и «L276-1» (DTC B1071-1B): 1 Ом или меньше. Сопротивление между клеммами «G12-3» и «L275-2», а также между клеммами «G12-4» и «L275-1» (DTC B1072-1B): 1 Ом или меньше. 09932–76010 Результаты проверки хорошие?？ Замените контроллер подушки безопасности и проверьте еще раз. Снятие/установка контроллера подушек безопасности Перейдите к шагу 4. Проверка цепи жгута панели приборов Убедитесь, что разъем «G343» надежно подключен. Снимите разъем «G343». Освободите короткий штифт на разъеме контроллера подушки безопасности. Как освободить короткий штифт Выполните следующие проверки. Сопротивление между клеммами «G12-21» и «G343-1», а также между клеммами «G12-20» и «G343-2» (DTC B1071-1B): 1 Ом или меньше. Сопротивление между клеммами «G12-3» и «G343-3», а также между клеммами «G12-4» и «G343-4» (DTC B1072-1B): 1 Ом или меньше. 09932–76010 Результаты проверки хорошие?？ Замените напольную обвязку. Замените жгут панели приборов.","sourceSha256":"6057e9ead7d2cfcffd0beab53cd432ba6be36142c1a995ee93c07e5e833c0c94","sectionId":"82","groupTitle":"Диагностика","variant":"10ch"}
