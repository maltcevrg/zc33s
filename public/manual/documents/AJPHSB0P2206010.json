e87d9bfd43312aece46d292ab11e2f056364ef42247ad5305a1cce7b959af","sourceSha256":"79bc296c92a88c9105641dbf201de7f95c00636ec4d5bc8c16b3c7c01985e3c9","sourceBytes":90206},{"sourceName":"IE3J0P220017.swf","path":"images/IE3J0P220017.webp","width":547,"height":425,"sha256":"b31d6764f9cf81ccf3df74ed6220645361d765540c06e85accd21a8d800d53d7","sourceSha256":"024287f0ac5463211e3f963dee54a9b87cef07a8357b1688a75c152547ea346e","sourceBytes":26856},{"sourceName":"IE3J0P220018.swf","path":"images/IE3J0P220018.webp","width":547,"height":482,"sha256":"fa4cd4e299421739b260cc17e744bbde873ea1faa3b453c6ace51dd4fc028325","sourceSha256":"47ef0dfe05e2b722a5581e5b7287786009362fb09444821d70578f3b977aa17b","sourceBytes":28204},{"sourceName":"I8G001220019.swf","path":"images/I8G001220019.webp","width":449,"height":419,"sha256":"938a4617af2e9cc4eb1d62fbcaea17161413de3a3914baf8d94def0078511294","sourceSha256":"5973c32d7d139d2388349334381091c8d3a6dcab2e38eaf3ebffc2c5ed3382c6","sourceBytes":24079}],"references":[{"targetId":"AJPHSB0P2206008","anchor":"","title":"Снятие/установка рычага подвески","available":true}],"sourceCounts":{"graphic":4,"servicetoolitem":4,"attention3":2,"intxrefpoff":1},"searchText":"Снятие/установка рычага подвески Задняя втулка рычага подвески замене не подлежит. Если есть проблема, замените рычаг подвески на новый. Удаление Канцелярским ножом отрежьте фланец (резиновую часть) (1) передней втулки рычага подвески. Снимите переднюю втулку рычага подвески (2) с помощью гидравлического пресса (1) и специального инструмента. Специальный инструмент (A) 09943–76340 (B) 09913–75821 Установка Используя специальный инструмент и гидравлический пресс (1), запрессуйте новую переднюю втулку рычага подвески (2). Установка будет проще, если нанести мыльную воду на внешнюю периферию передней втулки рычага подвески. Специальный инструмент (A) 09943–76340 (B) 09913–75821 Запрессуйте новую переднюю втулку рычага подвески (1) так, чтобы размеры «a» и «b» на схеме были равными.","sourceSha256":"8