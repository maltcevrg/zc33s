ren":["\nСнимите корпус катализатора (1) и прокладку с турбокомпрессора.\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"IHSB0P1B3006.jpg","width":"88.000mm","height":"54.937mm","path":"images/IHSB0P1B3006.webp","pixelWidth":716,"pixelHeight":500},"children":[]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nСнимите шпильки с турбокомпрессора.\n"]},"\n"]},"\n"]},"\n",{"tag":"servinfosub","attrs":{"id":"AJPHSB0P1B36002002"},"children":["\n",{"tag":"title","attrs":{},"children":["\nУстановка\n"]},"\n",{"tag":"attention4","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nЕсли при повторном использовании турбокомпрессора посадочная поверхность корпуса катализатора турбокомпрессора и его резьба заржавели, существует риск ослабления болтов и шпилек во время езды.\n"]},"\n",{"tag":"ptxt","attrs":{},"children":["\nЕсли ржавчина подтверждена, удалите ржавчину вокруг резьбы на установочной поверхности корпуса катализатора турбокомпрессора и обработайте резьбу метчиком.\n"]},"\n"]},"\n",{"tag":"ptxt","attrs":{},"children":["\nУстановка выполняется в порядке, обратном снятию, но обратите внимание на следующие моменты.\n"]},"\n",{"tag":"list1","attrs":{"type":"unordered"},"children":["\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nИспользуйте новые прокладки, уплотнительные кольца, болты корпуса катализатора, гайки корпуса катализатора и шпильки.\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nЗатягивайте шпильку до тех пор, пока часть с неполной резьбой не сядет на место.\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nУстановите корпус катализатора (1) и элемент жесткости корпуса катализатора (3), используя следующую процедуру.\n"]},"\n"]},"\n",{"tag":"list2","attrs":{"type":"ordered"},"children":["\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nВременно затяните вручную гайку корпуса нового катализатора (2).\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nВременно затяните вручную гайку жесткости корпуса катализатора (4) и болт (5).\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nЗатяните гайку корпуса катализатора и гайку жесткости корпуса катализатора до упора, затем ослабьте их на 90 градусов.\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nЗатяните болт жесткости корпуса катализатора до упора.\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nЗатяните новый болт корпуса катализатора (6) и гайку указанным моментом затяжки.\n"]},"\n",{"tag":"torque","attrs":{},"children":["\n",{"tag":"torqueitem","attrs":{"id":"T1K309"},"children":["\n",{"tag":"t-part","attrs":{},"children":["\nболт корпуса катализатора\n"]},"\n",{"tag":"t-part1","attrs":{},"children":["\na\n"]},"\n",{"tag":"t-value1","attrs":{},"children":["\n40\n"," Нм"]},"\n"]},"\n",{"tag":"torqueitem","attrs":{"id":"T1K310"},"children":["\n",{"tag":"t-part","attrs":{},"children":["\nгайка корпуса катализатора\n"]},"\n",{"tag":"t-part1","attrs":{},"children":["\nb\n"]},"\n",{"tag":"t-value1","attrs":{},"children":["\n40\n"," Нм"]},"\n"]},"\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nЗатяните гайку жесткости корпуса катализатора указанным моментом затяжки.\n"]},"\n",{"tag":"torque","attrs":{},"children":["\n",{"tag":"torqueitem","attrs":{"id":"T1K311"},"children":["\n",{"tag":"t-part","attrs":{},"children":["\nГайка жесткости корпуса катализатора\n"]},"\n",{"tag":"t-part1","attrs":{},"children":["\nc\n"]},"\n",{"tag":"t-value1","attrs":{},"children":["\n25\n"," Нм"]},"\n"]},"\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag"