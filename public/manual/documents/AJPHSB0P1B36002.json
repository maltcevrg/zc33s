2","available":true},"children":["Снятие/установка датчика O2"]},"\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nКаждый О",{"tag":"sub","attrs":{},"children":["2"]},"Закрепите желтую маркировочную часть жгута датчика с помощью зажима. \n",{"tag":"intxreftitleoff1","attrs":{"refid":"AJPHSB0P1336015","targetTitle":"Снятие/установка датчика O2","available":true},"children":["Снятие/установка датчика O2"]},"\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nЗалейте охлаждающей жидкостью. \n",{"tag":"intxreftitleoff1","attrs":{"refid":"AJPHSB0P1636005","targetTitle":"наполнение охлаждающей жидкостью","available":true},"children":["наполнение охлаждающей жидкостью"]},"\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nПроверьте наличие утечек охлаждающей жидкости. \n",{"tag":"intxreftitleoff1","attrs":{"refid":"AJPHSB0P1636003","targetTitle":"Проверка системы охлаждения","available":true},"children":["Проверка системы охлаждения"]},"\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nЗапустите двигатель и проверьте, нет ли утечек воды или утечек выхлопных газов из каких-либо частей.\n"]},"\n"]},"\n"]},"\n"]},"\n"],"anchors":["AJPHSB0P1B36002001","AJPHSB0P1B36002002","T1K309","T1K310","T1K311","T1K312","T1K313"],"images":[{"sourceName":"IHSB0P1B3002.jpg","path":"images/IHSB0P1B3002.webp","width":716,"height":508,"sha256":"94eeaf881c73bb8f56bfb5bcc7dee11a83b03bc099df8d565dcfb01cc30db2c3","sourceSha256":"e56ad38b8d57eb883c2bb55b8d29280f7728813f71bc6b1f8df4ffcc65fce447","sourceBytes":59460},{"sourceName":"IHSB0P1B3003.jpg","path":"images/IHSB0P1B3003.webp","width":716,"height":500,"sha256":"6af808f840c6be5542e21ba7a2f4c64442a484ca2b0d6bd35a4a855c23fb15ba","sourceSha256":"b1a200e37705412440eeff042056475ca2ab8da10039d9e7f2a5c9be55aed802","sourceBytes":72396},{"sourceName":"IHSB0P1B3