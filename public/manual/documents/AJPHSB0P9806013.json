м порядке, но обратите внимание на следующие моменты.\n"]},"\n",{"tag":"list1","attrs":{"type":"unordered"},"children":["\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nЗатяните болт переднего ремня безопасности указанным моментом. \n",{"tag":"intxreftitleoff1","attrs":{"refid":"AJPHSB0P8106001","targetTitle":"Схема расположения передних ремней безопасности","available":true},"children":["Схема расположения передних ремней безопасности"]},"\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nЗатяните болт заднего ремня безопасности указанным моментом. \n",{"tag":"intxreftitleoff1","attrs":{"refid":"AJPHSB0P8106006","targetTitle":"Схема расположения задних ремней безопасности","available":true},"children":["Схема расположения задних ремней безопасности"]},"\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nПрикрепите облицовку передней стойки (1) к ремню безопасности (2), как показано на рисунке.\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"IGSA0P980029.jpg","width":"88.000mm","height":"83.332mm","path":"images/IGSA0P980029.webp","pixelWidth":824,"pixelHeight":796},"children":[]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"],"anchors":["AJPHSB0P9806013001","AJPHSB0P9806013002","AJPHSB0P9806013003","AJPHSB0P9806013004","AJPHSB0P9806013005","AJPHSB0P9806013006","AJPHSB0P9806013007","AJPHSB0P9806013008","AJPHSB0P9806013009"],"images":[{"sourceName":"IGSA0P980017.jpg","path":"images/IGSA0P980017.webp","width":824,"height":540,"sha256":"dd6ac8c03476e904ffc78d48fd58103d4dcec0ccc386cf86449dcfa670b9129b","sourceSha256":"15bc64b1716af2b8f757b2b22e544f9eb4ae3f4ae89532f9d823e7d895f92f72","sourceBytes":61672},{"sourceName":"IGSA0P980018.jpg","path":"images/IGSA0P980018.webp","width":824,"height":648,"sha256":"450b671ca210136a6a2b779857e7229351f0e21c8a306dcb3c0a41ba69bec63c","sourceSha256":"689fb72994055102a7b5