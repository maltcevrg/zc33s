rs":{},"children":["\nУстановка\n"]},"\n",{"tag":"ptxt","attrs":{},"children":["\n",{"tag":"intxrefpoff","attrs":{"refid":"AJPHSB0P9A06002","targetTitle":"Осмотр/регулировка переднего капота","available":true},"children":["Осмотр/регулировка переднего капота"]},"\n"]},"\n",{"tag":"ptxt","attrs":{},"children":["\nДля установки выполните процедуру снятия в обратном порядке, но обратите внимание на следующие моменты.\n"]},"\n",{"tag":"list1","attrs":{"type":"unordered"},"children":["\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nОтрегулируйте положение замка капота. \n",{"tag":"intxreftitleoff1","attrs":{"refid":"AJPHSB0P9A06002","targetTitle":"Осмотр/регулировка переднего капота","available":true},"children":["Осмотр/регулировка переднего капота"]},"\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nЕсли краска на болте петли капота отслаивается, перекрасьте его, чтобы предотвратить ржавчину.\n"]},"\n"]},"\n"]},"\n"]},"\n"],"anchors":["AJPHSB0P9A06001001","AJPHSB0P9A06001002"],"images":[{"sourceName":"IGSA0P9A0001.jpg","path":"images/IGSA0P9A0001.webp","width":716,"height":410,"sha256":"3afeac7da7f74c171eaff5b3e0921d1d1e2f79b0d893adc1dfacf1ff0dc2227f","sourceSha256":"af7099c63c98d73356aaef5ac3a9c1c4d1a5ddd4f5d7f94be92ba34acb8bd79d","sourceBytes":21646},{"sourceName":"IGSA0P9A0002.jpg","path":"images/IGSA0P9A0002.webp","width":558,"height":511,"sha256":"b5193ec85d5a94931af79c21763825c955c2d1ad331c5a206ff86d882a041023","sourceSha256":"571b5f0cff80324169348db6f71f3b5d694ce5ea952dc4da530880d2d38e4b6d","sourceBytes":36518}],"references":[{"targetId":"AJPHSB0P9806005","anchor":"","title":"Снятие/установка декоративной отделки капота","available":true},{"targetId":"AJPHSB0P9A06002","anchor":"","title":"Осмотр/регулировка переднего капота","available":true},{"targetId":"AJPHSB0P9A06002","anchor":"","title":"Осмотр/регулировка переднего капота","available":true}],"sourceCounts":{"graphic":2,"attention4":1,"intxrefpoff":1,"intxreftitleoff1":2},"searchText":"Удаление При снятии и установке переднего капота при ударе переднего капота о кузов существует вероятность повреждения окрашенной поверхности. При работе защищать окрашенную поверхность тканью и т.п. Выверните болт петли капота (1) и снимите передний капот (2). При необходимости снимите петлю капота (1), выполнив следующие действия. Снимите декоративную отделку верхней части капота. Снятие/установка декоративной отделки капота Выверните болт (2) и снимите петлю капота. Установка Осмотр/регулировка переднего капота Для установки выполните процедуру снятия в обратном порядке, но обратите внимание на следующие моменты. Отрегулируйте положение замка капота. Осмотр/регулировка переднего капота Если краска на болте петли капота отслаивается, перекрасьте его, чтобы предотвратить ржавчину.","sourceSha256":"039c9e35a30679a900c1ad46d5221cc466c52371a4a26f1f96002247f96ea2a8","sectionId":"9A","groupTitle":"Обслуживание","variant":null}
