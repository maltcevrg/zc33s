a3baa35e0a06809c35893c01f55edd3d10f9600","sourceSha256":"56e55dc478902cdc9cd7620f3a79484c9067637fd2a4101b097443fadf8251ae","sourceBytes":159928}],"references":[{"targetId":"AJPHSB0P9F04001","anchor":"","title":"Всенаправленный контроль монитора","available":true},{"targetId":"AJPHSB0P9F06021","anchor":"","title":"Снятие/установка контроллера камеры","available":true},{"targetId":"AJPHSB0P9F06018","anchor":"","title":"Снятие/установка передней камеры","available":true},{"targetId":"AJPHSB0P9F06019","anchor":"","title":"Снятие/установка боковой камеры","available":true},{"targetId":"AJPHSB0P9F06019","anchor":"","title":"Снятие/установка боковой камеры","available":true},{"targetId":"AJPHSB0P9F06021","anchor":"","title":"Снятие/установка контроллера камеры","available":true},{"targetId":"AJPHSB0P9F06020","anchor":"","title":"Снятие/установка задней камеры","available":true}],"sourceCounts":{"graphic":1,"table":2,"testgroup":7,"result":14,"action":14,"attention3":1,"intxref":1,"intxreftitleoff1":6},"searchText":"Детали диагностики/предполагаемое местонахождение дефекта Детали диагноза Предполагаемое место дефекта B1D06: Ошибка системы питания камеры Код неисправности обнаруживается при выполнении одного из следующих условий: Напряжение питания передней, правой, левой или задней камеры в течение определенного периода времени оставалось ниже 5,3 В. Напряжение питания передней, правой, левой или задней камеры остается на уровне 6,7 В или выше в течение определенного периода времени. Проводка/разъем каждой камеры каждая камера контроллер камеры принципиальная схема [A]: Разъем контроллера камеры (вид стрелки: [a]) B4: Линия видеосигнала задней камеры D4: Провод заземления видеокамеры заднего вида A1: линия электропередачи передней камеры C1: провод заземления передней камеры 1. передняя камера A2: Линия электропитания камеры справа C2: Провод заземления правой боковой камеры 2. правая боковая камера A3: Линия электропитания камеры слева C3: Заземляющий провод левой камеры 3. левая боковая камера A4: Линия электропередачи задней камеры C4: провод заземления задней камеры 4. задняя камера B1: Линия видеосигнала передней камеры D1: Заземляющий провод видеокамеры передней камеры 5. экранированный провод B2: Линия видеосигнала правой боковой камеры D2: Заземляющий провод видеокамеры с правой стороны 6. контроллер камеры B3: Линия видеосигнала левой боковой камеры D3: Заземляющий провод видеокамеры слева Процедура воспроизведения кода неисправности Включите зажигание минимум на 10 секунд. Диагностика неисправностей Если обнаружен DTC B1D06, напряжение питания камеры будет равно 0 В через 10 секунд после включения зажигания. При измерении напряжения переключитесь на видеокамеру и измерьте напряжение в течение 10 секунд после включения зажигания. Проводили ли вы «всенаправленную мониторную проверку»?？ Перейдите к шагу 2. Всенаправленный контроль монитора Осуществлять. Проверка линии электропередачи с помощью камеры Выключите зажигание и отсоедините разъем передней камеры, разъем правой боковой камеры, разъем левой боковой камеры и разъем задней камеры. Проверьте клеммные соединения разъема передней камеры, разъема правой камеры, разъема левой камеры и разъема задней камеры. Если клеммные соединения в порядке, включите зажигание. Убедитесь, что напряжение между каждой линией питания камеры (от A1 до A4) и массой корпуса составляет примерно 6 В. Результаты проверки хорошие?？ Перейдите к шагу 4. Перейдите к шагу 3. Проверка линии электропередачи с помощью камеры Выключите зажигание и отсоедините разъем контроллера камеры. Проверьте клеммные соединения разъема контроллера камеры. Если клеммные соединения в порядке, проверьте каждый провод питания камеры (от A1 до A4) на наличие следующих элементов. Сопротивление изоляции между каждой линией питания камеры и заземлением корпуса бесконечно. Сопротивление изоляции между клеммой линии электропитания передней камеры разъема контроллера камеры и другими клеммами бесконечно. Сопротивление изоляции между правой клеммой линии электропитания камеры разъема контроллера камеры и другими клеммами бесконечно. Сопротивление изоляции между левой клеммой линии питания камеры разъема контроллера камеры и другими клеммами бесконечно. Сопротивление изоляции между клеммой линии электропитания задней камеры разъема контроллера камеры и другими клеммами бесконечно. Когда зажигание включено, напряжение между каждой линией питания камеры и массой кузова составляет от 0 до 1 В. Результаты проверки хорошие?？ Замените контроллер камеры и еще раз проверьте код неисправности. Снятие/установка контроллера камеры Отремонтируйте или замените неисправную проводку. Проверка передней камеры Выключите зажигание и подсоедините разъем передней камеры. Включите зажигание и убедитесь, что напряжение между клеммой линии питания передней камеры (А1) разъема контроллера камеры и массой кузова составляет примерно 6 В. Результаты проверки хорошие?？ Перейдите к шагу 5. Замените переднюю камеру. Снятие/установка передней камеры Проверка правой боковой камеры Выключите зажигание и подсоедините разъем правой боковой камеры. Включите зажигание и убедитесь, что напряжение между клеммой правой линии питания камеры (А2) разъема контроллера камеры и массой кузова составляет примерно 6 В. Результаты проверки хорошие?？ Перейдите к шагу 6. Замените правую боковую камеру. Снятие/установка боковой камеры Проверка левой боковой камеры Выключите зажигание и подсоедините разъем левой боковой камеры. Включите зажигание и убедитесь, что напряжение между клеммой левой линии питания камеры (А3) разъема контроллера камеры и массой кузова составляет примерно 6 В. Результаты проверки хорошие?？ Перейдите к шагу 7. Замените левую боковую камеру. Снятие/установка боковой камеры Проверка задней камеры Выключите зажигание и подсоедините разъем задней камеры. Включите зажигание и убедитесь, что напряжение между клеммой линии питания задней камеры (А4) разъема контроллера камеры и массой кузова составляет примерно 6 В. Результаты проверки хорошие?？ Замените контроллер камеры и еще раз проверьте код неисправности. Снятие/установка контроллера камеры Замените заднюю камеру. Снятие/установка задней камеры","sourceSha256":"8d002a418622c63037d7907ad5b7331973b3580712cefe03e1e1359f6cf54c10","sectionId":"9F","groupTitle":"Диагностика","variant":null}
