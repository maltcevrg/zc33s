n":["\n",{"tag":"ptxt","attrs":{},"children":["\n[B]:\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"4","align":"left"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nНет\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nС помощью тестера проверьте целостность цепи между сегментом коммутатора и сердечником якоря.\n"]},"\n",{"tag":"ptxt","attrs":{},"children":["\nЕсли непрерывность есть, якорь закорочен и его следует заменить.\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"I2RH01190019.swf","width":"88.000mm","height":"46.259mm","path":"images/I2RH01190019.webp","pixelWidth":1245,"pixelHeight":796},"children":[]},"\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nС помощью тестера цепей проверьте непрерывность между сегментами коммутатора.\n"]},"\n",{"tag":"ptxt","attrs":{},"children":["\nЕсли непрерывности нет, то цепь разорвана и якорь следует заменить.\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"I2RH01190020.swf","width":"88.000mm","height":"46.344mm","path":"images/I2RH01190020.webp","pixelWidth":1236,"pixelHeight":798},"children":[]},"\n"]},"\n"]},"\n"]},"\n"]},"\n",{"tag":"servinfosub","attrs":{"id":"AJPHSB0P1936005015"},"children":["\n",{"tag":"title","attrs":{},"children":["\nПроверка передач\n"]},"\n",{"tag":"ptxt","attrs":{},"children":["\nОсмотрите шестерни на предмет износа и повреждений.\n"]},"\n",{"tag":"ptxt","attrs":{},"children":["\nЕсли есть проблема, замените его.\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"I2RH01190021.swf","width":"88.000mm","height":"47.952mm","path":"images/I2RH01190021.webp","pixelWidth":1252,"pixelHeight":830},"children":[]},"\n"]},"\n"]},"\n",{"tag":"servinfosub","attrs":{"id":"AJPHSB0P1936005016"},"children":["\n",{"tag":"title","attrs":{},"children":["\nПроверка шестерни и обгонной муфты\n"]},"\n",{"tag":"list1","attrs":{"type":"unordered"},"children":["\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nУбедитесь, что обгонная муфта (обгонная муфта) вращается не в направлении [a], а только в направлении [b], как показано на схеме. Также проверьте шестерню на предмет чрезмерного износа.\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"IAP70P190007.swf","width":"88.000mm","height":"55.699mm","path":"images/IAP70P190007.webp","pixelWidth":1382,"pixelHeight":982},"children":[]},"\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nУбедитесь, что шестерня движется плавно.\n"]},"\n"]},"\n",{"tag":"item","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nУбедитесь, что шлицы, показанные на рисунке, не имеют износа и повреждений. \n"]},"\n",{"tag":"ptxt","attrs":{},"children":["\nЕсли есть проблема, замените его.\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"I2RH01190023.swf","width":"88.000mm","height":"36.353mm","path":"images/I2RH01190023.webp","pixelWidth":952,"pixelHeight":602},"children":[]},"\n"]},"\n"]},"\n"]},"\n"]},"\n",{"tag":"servinfosub","attrs":{"id":"AJPHSB0P1936005017"},"children":["\n",{"tag":"title","attrs":{},"children":["\nПроверка втулки корпуса якоря\n"]},"\n",{"tag":"ptxt","attrs":{},"children":["\nОсмотрите втулку корпуса якоря на предмет износа и повреждений.\n"]},"\n",{"tag":"ptxt","attrs":{},"children":["\nЕсли есть проблема, замените втулку.\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"I2RH01190024.swf","width":"88.000mm","height":"46.936mm","path":"images/I2RH01190024.webp","pixelWidth":870,"pixelHeight":810},"children":[]},"\n"]},"\n"]},"\n"],"anchors":["AJPHSB0P1936005001","AJPHSB0P1936005002","AJPHSB0P1936005003",