a2fece335922c4b085f5aa","sourceBytes":48575},{"sourceName":"IGSA0P460025.jpg","path":"images/IGSA0P460025.webp","width":533,"height":616,"sha256":"58cc4125a043433186190df836e0da414135524da8f43235b93b3ae19d70b3aa","sourceSha256":"51afb743a2144d1bb2af0a764ead7341fe8d87301b93a77ff2f757e44bb12071","sourceBytes":49338},{"sourceName":"IGSA0P460026.jpg","path":"images/IGSA0P460026.webp","width":670,"height":886,"sha256":"4e46cbebd02fec6afd4ba8ca5a085e339807c1cbd9430ef061822a525967c0f0","sourceSha256":"1be6f613a11790642992407be112a8f59b52f472c1fac32942c6ce119846ba9b","sourceBytes":71224}],"references":[{"targetId":"AJPHSB0P2406001","anchor":"","title":"Снятие/установка колеса (с шиной)","available":true},{"targetId":"AJPHSB0P9A06004","anchor":"","title":"Схема конфигурации переднего крыла","available":true},{"targetId":"AJPHSB0P4606010","anchor":"","title":"Проверка датчиков скорости передних и задних колес","available":true}],"sourceCounts":{"graphic":4,"table":1,"torqueitem":1,"attention4":1,"intxrefpoff":1,"intxreftitleoff1":2},"searchText":"Жгут может быть поврежден, если его с силой тянуть или скручивать при установке датчика скорости колеса. При установке датчика скорости колеса будьте осторожны, не тяните и не перекручивайте жгут проводов больше, чем необходимо. Удаление Поднимите автомобиль и снимите колеса. Снятие/установка колеса (с шиной) Снимите облицовку переднего крыла. Схема конфигурации переднего крыла Отсоедините разъем датчика скорости переднего колеса (1). Снимите зажим (1). Выверните болт датчика скорости колеса (1) и снимите датчик скорости переднего колеса (2) с поворотного кулака. Установка Проверка датчиков скорости передних и задних колес Для установки выполните процедуру снятия в обратном порядке, но обратите внимание на следующие моменты. Убедитесь, что к детекторной части датчика скорости колеса (1) или энкодера скорости колеса не прилипли посторонние предметы. Затяните болт датчика скорости колеса (2) указанным моментом. болт датчика скорости переднего колеса a 11 Нм Убедитесь, что между датчиком скорости колеса и поворотным кулаком (3) нет зазора. [A]: OK [B]: NG","sourceSha256":"8ecd77a1680c9d6b22a488c7915f0b82d596bdabd387fdfdfd6788bef3a8c357","sectionId":"46","groupTitle":"Обслуживание","variant":null}
