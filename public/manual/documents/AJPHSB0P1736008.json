23.webp","width":770,"height":306,"sha256":"ad7762ca483381677cd60bcd86ae37d2978f3a4e4b429d2a2ea5a93565a37bf9","sourceSha256":"3d440f81dcd81973d46aa304246080434f59c8e0cb6a441b5eb37e770e5b8d1c","sourceBytes":17333},{"sourceName":"IFAE0A170021.jpg","path":"images/IFAE0A170021.webp","width":731,"height":493,"sha256":"cc99f8622174ed4ee3a4c6a1580b2d1d9798857daa04c09b5ccc51c5563b6890","sourceSha256":"d97b35964842002e08b897168dbd9806816f6d1998a8520d0b97490a20e5f77f","sourceBytes":54023},{"sourceName":"IHSB0P173014.jpg","path":"images/IHSB0P173014.webp","width":716,"height":508,"sha256":"b0c3deb40b548d55f1bfcad157ee4813f968910cca65f6900525a28f255f8076","sourceSha256":"8015b7aa6af6213d4db72aaf02caa9fb224e793aba6e67d1441fd2ce3b12434b","sourceBytes":67633},{"sourceName":"IHSB0P173015.jpg","path":"images/IHSB0P173015.webp","width":716,"height":515,"sha256":"aa93dfefeefafb57ab3bcc7d738d1125227eacef5d0041746b663a3f9e733508","sourceSha256":"1dbae8eb831dbd9c77a72002c5f15394f6663b892771cd90ad69e8626b6d2d83","sourceBytes":69426}],"references":[{"targetId":"AJPHSB0P1736001","anchor":"","title":"Схема конфигурации топливной системы","available":true},{"targetId":"AJPHSB0P1736005","anchor":"","title":"Проверка топливной магистрали на автомобиле","available":true},{"targetId":"AJPHSB0P1730001","anchor":"","title":"Меры предосторожности при работе","available":true},{"targetId":"AJPHSB0P9806012","anchor":"","title":"Снятие/установка нижней крышки двигателя","available":true},{"targetId":"AJPHSB0P1736003","anchor":"","title":"сброс давления топлива","available":true},{"targetId":"AJPHSB0P1436017","anchor":"","title":"Снятие/установка корпуса дроссельной заслонки","available":true},{"targetId":"AJPHSB0P1436017","anchor":"","title":"Снятие/установка корпуса дроссельной заслонки","available":true},{"targetId":"AJPHSB0P1736004","anchor":"","title":"Проверка утечки топлива","available":true},{"targetId":"AJPHSB0P9806012","anchor":"","title":"Снятие/установка нижней крышки двигателя","available":true}],"sourceCounts":{"graphic":5,"table":2,"torqueitem":3,"attention3":2,"intxref":1,"intxrefpoff":2,"intxreftitleoff1":6},"searchText":"Схема конфигурации топливной системы: K14C Бортовая проверка топливопровода: K14C Прежде чем сделать следующий шаг Меры предосторожности при работе: K14C Проверять. Удаление Поднимите автомобиль и снимите нижнюю крышку двигателя и правую часть нижней крышки двигателя. Снятие/установка нижней крышки двигателя Снять давление топлива. сброс давления топлива Снимите корпус дроссельной заслонки. Снятие/установка корпуса дроссельной заслонки Снимите крышку топливного насоса высокого давления. Снимите трубку высокого давления (1). Установка При монтаже трубок высокого давления, если не соблюдать следующие пункты, существует опасность повреждения трубок и возникновения утечки топлива. Не используйте повторно трубы высокого давления. При затягивании накидной гайки путем подсоединения ключа с гусиной лапкой (переходного адаптера) к динамометрическому ключу, если вы затягиваете указанный крутящий момент, она будет перетянута и может повредить винт. Используйте следующую формулу, чтобы рассчитать значение крутящего момента, соразмерное длине рычага (эффективной длине) динамометрического ключа, и затянуть до этого значения. формула расчета M = T×L / (L＋“a”) M: Значение крутящего момента динамометрического ключа T: Указанный момент затяжки L: эффективная длина динамометрического ключа (м) «a»: эффективная длина смещенного адаптера (м) “b”: Центр захвата (точка питания) “c”: Ось вращения (точка опоры) Соберите трубы высокого давления следующим образом. Выровняйте шкив коленчатого вала так, чтобы положение маркировки (1) находилось в пределах диапазона «b». “a”: 10° “b”: 20° Один раз ослабьте болт топливного насоса высокого давления (1), затяните его моментом 5,0 Н м, затем ослабьте на 90–120 градусов. Затяните вручную соединительную гайку трубопровода высокого давления (2) до посадки и временно затяните болт трубопровода высокого давления (3). Затяните соединительные гайки трубопровода высокого давления (1) с указанным моментом в порядке цифр («от 1» до «2»), показанном на схеме. накидная гайка трубопровода высокого давления* a 33 Нм Затяните болт топливного насоса высокого давления (2) указанным моментом затяжки. болт топливного насоса высокого давления b 13 Нм Затяните болт трубопровода высокого давления (3) указанным моментом затяжки. болт трубы высокого давления c 11 Нм Установите крышку топливного насоса высокого давления. Установите корпус дроссельной заслонки. Снятие/установка корпуса дроссельной заслонки Проверьте отсутствие утечек топлива. Проверка утечки топлива Установите нижнюю крышку двигателя и правую нижнюю крышку двигателя. Снятие/установка нижней крышки двигателя","sourceSha256":"3836e085a9c3f3a580220d424f4620a60f59f783450459ee80423aca8e90fde6","sectionId":"17","groupTitle":"Обслуживание","variant":"K14C"}
