ного поршня B1 (1).\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"IEL10C510170.swf","width":"88.000mm","height":"54.945mm","path":"images/IEL10C510170.webp","pixelWidth":752,"pixelHeight":504},"children":[]},"\n"]},"\n"]},"\n",{"tag":"s2","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nСнимите крышку тормозного поршня B1 (1), тормозной поршень B1 (2) и пружину тормозного поршня B1 (3).\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"IEL10C510342.swf","width":"88.000mm","height":"63.221mm","path":"images/IEL10C510342.webp","pixelWidth":695,"pixelHeight":587},"children":[]},"\n"]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nСнимите упорный подшипник первичного вала (1), обойму упорного подшипника первичного вала (2) и муфту переднего хода (3).\n"]},"\n",{"tag":"attention3","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nЕсли вы не можете найти упорный подшипник входного вала, возможно, он оторвался при снятии входного вала.\n"]},"\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"IEL10C510343.swf","width":"88.000mm","height":"53.062mm","path":"images/IEL10C510343.webp","pixelWidth":724,"pixelHeight":482},"children":[]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nСнимите упорный подшипник входного барабана солнечной шестерни (1), кольцо упорного подшипника входного барабана солнечной шестерни (2) и входной барабан солнечной шестерни (3).\n"]},"\n",{"tag":"figure","attrs":{},"children":["\n",{"tag":"graphic","attrs":{"graphicname":"IEL10C510344.swf","width":"88.000mm","height":"56.006mm","path":"images/IEL10C510344.webp","pixelWidth":677,"pixelHeight":515},"children":[]},"\n"]},"\n"]},"\n",{"tag":"s1","attrs":{},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nСнимите пружину 