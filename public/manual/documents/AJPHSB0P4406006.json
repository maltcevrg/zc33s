cc8dd2016e0b4de00b48fa21ef1785da82bd32b6a38","sourceBytes":33062},{"sourceName":"IGSA0P440009.jpg","path":"images/IGSA0P440009.webp","width":821,"height":565,"sha256":"c279d276a4504a72bf942476f84074a579eb5629b10488728ddd7a9dd7c6c106","sourceSha256":"1fc891abf1b972be2c5a8b9e66ceaa5a35e8c733c90be221c1e442ff7918aa39","sourceBytes":52773},{"sourceName":"IGSA0P440011.jpg","path":"images/IGSA0P440011.webp","width":803,"height":756,"sha256":"d74e6558174df1cac20956cfcfbacfaa44454907d273ee2c580d10c6cc183104","sourceSha256":"84d628ae4c9a65a1fa65ff62eb625e50f03bfce2041c015409337cf41b4eaa9a","sourceBytes":35137},{"sourceName":"IGSA0P440012.jpg","path":"images/IGSA0P440012.webp","width":824,"height":756,"sha256":"2c1b81e86339acc7d6a1377eb12b80c55d5f215a43e70e4bbcf6cbc9577fd313","sourceSha256":"354c24421f3ff1eae9f25ee69a50057ebf8e154796260f6fb4314cd97bd55732","sourceBytes":36731}],"references":[{"targetId":"AJPHSB0P9806013","anchor":"","title":"Снятие/установка обшивки/коробки консоли","available":true},{"targetId":"AJPHSB0P4406002","anchor":"","title":"Проверка стояночного тормоза","available":true}],"sourceCounts":{"graphic":4,"torqueitem":1,"intxreftitleoff1":2},"searchText":"Удаление Остановите автомобиль на ровной поверхности, переведите рычаг выбора передач в положение P и заблокируйте колеса. Снимите коробку напольной консоли. Снятие/установка обшивки/коробки консоли Отсоедините разъем SW (2) стояночного тормоза от рычага стояночного тормоза (1). Ослабьте регулировочную гайку (1). Выверните болт рычага стояночного тормоза (1) и снимите рычаг стояночного тормоза (2) вместе с уравнительной частью рычага стояночного тормоза (3). Установка Для установки выполните процедуру снятия в обратном порядке, но обратите внимание на следующие моменты. Затяните болт рычага стояночного тормоза (1) указанным моментом. Момент затяжки болт рычага стояночного тормоза a 26 Нм Установите трос стояночного тормоза (2) и отрегулируйте трос стояночного тормоза. Проверка стояночного тормоза После регулировки троса стояночного тормоза проверьте правильность работы тормозной системы.","sourceSha256":"4e508bf1d97937a17333eab24e712084d962d00db531118593a6cf4a16c46d2a","sectionId":"44","groupTitle":"Обслуживание","variant":null}
