eSha256":"5e405adfcfc29a854fdc7d6c74572ea30288f6be865d850c7c46e3c5009e5b48","sourceBytes":32874},{"sourceName":"IGSA0P960026.jpg","path":"images/IGSA0P960026.webp","width":493,"height":533,"sha256":"9db6a5e04c48cb65c5768c453898fe9d3519596236ac6f1c67f34bdc53219e0f","sourceSha256":"04a7a1177905b8d409048bf09a0d7924535d66e875d38b2ae353562b4891f6a2","sourceBytes":23986},{"sourceName":"IGSA0P960027.jpg","path":"images/IGSA0P960027.webp","width":824,"height":536,"sha256":"e3437c198429439b417bab6e23b9f30e6f7eeb5bb79f40706c6f87e3a795a3b4","sourceSha256":"0b1efc2c152096521b6f4d1ae68bac3cd0d72226bea1ad1bbaae7d667d09ab83","sourceBytes":34429}],"references":[{"targetId":"AJPHSB0P9606005","anchor":"","title":"Схема конфигурации узла замка задней двери","available":true}],"sourceCounts":{"graphic":4,"table":1,"intxreftitleoff1":1},"searchText":"Удаление Снимите обшивку задней двери. Схема конфигурации узла замка задней двери Снимите разъем устройства открывания задней двери/запросного SW (1). Нажмите на выступ (2) нижней накладки двери багажного отделения (1) в направлении стрелки «1», чтобы снять нижнюю накладку двери багажного отделения. Выверните винт (1) и снимите механизм открывания задней двери/запросный SW (2) с нижней накладки задней двери (3). 4. держатель переключателя задней двери Установка Для установки выполните процедуру снятия в обратном порядке, но обратите внимание на следующие моменты. Установите нижнюю накладку задней двери (1) в порядке, указанном стрелками.","sourceSha256":"8a30629f1c1d7c1de51aeba3bfc34554131f4d6480269f4bf349f01192d29a00","sectionId":"96","groupTitle":"Обслуживание","variant":null}
