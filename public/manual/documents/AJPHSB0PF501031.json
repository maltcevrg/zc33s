,"valign":"middle"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nредуктор 2-го вала\n"]},"\n"]},"\n"]},"\n",{"tag":"row","attrs":{},"children":["\n",{"tag":"entry","attrs":{"colname":"2","valign":"middle"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nведомая шестерня редуктора\n"]},"\n"]},"\n"]},"\n",{"tag":"row","attrs":{},"children":["\n",{"tag":"entry","attrs":{"colname":"1","morerows":"2","valign":"middle"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nМасло редуктора (PTO)\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"2","valign":"middle"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nРекомендуемое масло\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"3","valign":"middle","align":"center"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nМасло для четырехколесных трансмиссий Suzuki 75W.\n"]},"\n"]},"\n"]},"\n",{"tag":"row","attrs":{},"children":["\n",{"tag":"entry","attrs":{"colname":"2","valign":"middle"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nемкость\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"3","valign":"middle","align":"center"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n0.6\n"]},"\n"]},"\n"]},"\n",{"tag":"row","attrs":{},"children":["\n",{"tag":"entry","attrs":{"colname":"2","valign":"middle"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nСрок замены\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"3","valign":"middle","align":"center"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nНе требует замены («каждые 75 000 км в тяжелых условиях»)\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"],"anchors":["AJPHSB0PF501031001","AJPHSB0PF501031002"],"images":[{"sourceName":"IFKA0QF50013.jpg","path":"images/IFKA0QF50013.webp","width":1800,"height":1163,"sha256":"c245aa003e57d0707d47d8b5bfb74cf3294ea7989746a841bea999e35902777d","sourceSha256":"ec60eb73868fa2ac6abd53cc45b6e5d19c048e86fd720e77edab90f40d662b55","sourceBytes":179500},{"sourceName":"IFKA0QF50014.jpg","path":"images/IFKA0QF50014.webp","width":1228,"height":785,"sha256":"9f5904bbb9b3064c8f184a7a29f4da8abf25677af9d21a44f6974d317488f992","sourceSha256":"c6a62fd9ee3d324bebf531a7a4b252fca4c491e8d654c0660b03e45a47598c95","sourceBytes":103048}],"references":[],"sourceCounts":{"graphic":2,"table":2},"searchText":"Редуктор (в сборе PTO) (1) передает вращение МГУ (приводного двигателя) (2) на конечную передачу (7) при движении, а вращение шин на МГУ (приводной двигатель) при регенерации. Редуктор (PTO в сборе) состоит из входного вала электродвигателя (3), соединенного с МГУ (приводным электродвигателем), понижающего 1-го вала (4) и понижающего 2-го вала (5), осуществляющих торможение/ускорение, ведомой понижающей шестерни (6), соединяющей 2-й понижающий вал и конечную шестерню и использующей цепь для передачи мощности между каждым валом. 8. входная цепь двигателя 9. Мотор-редуктор 1-й цепи путь передачи При движении МГУ (приводной двигатель) Вращение МГУ (приводного электродвигателя) передается при замедлении вращения в следующем порядке: входной вал двигателя (1) → понижающий 1-й вал (2) → понижающий 2-й вал (3) → понижающая ведомая шестерня (4) → конечная шестерня (5). Существует две стадии замедления: первичная сторона представляет собой входной вал двигателя на 1-й вал понижения, а вторичная сторона представляет собой 1-й вал понижения на 2-й вал понижения. Во время регенерации Вращение шин передается через МГУ (приводной двигатель) в направлении, противоположном тому, которое используется при движении, увеличивая скорость вращения. Технические характеристики редуктора (PTO в сборе) передаточное число Первичная сторона (от входного вала двигателя до 1-го вала редуктора) 1.714 (36/21) Вторичная сторона (редуктор 1-го вала ~ редуктор 2-го вала) 1.286 (27/21) несущий входной вал двигателя шарикоподшипник редуктор 1-го вала редуктор 2-го вала ведомая шестерня редуктора Масло редуктора (PTO) Рекомендуемое масло Масло для четырехколесных трансмиссий Suzuki 75W. емкость 0.6 Срок замены Не требует замены («каждые 75 000 км в тяжелых условиях»)","sourceSha256":"91950ed54c204daed2e2141826d7fb890cbb318a5f32b8f24447d95743cf379d","sectionId":"F5","groupTitle":"Трансмиссия","variant":null}
