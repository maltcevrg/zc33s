"valign":"middle","align":"center"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"4","valign":"middle","align":"center"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"5","valign":"middle","align":"center"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n",{"tag":"symbol","attrs":{"name":"MACIRCLE_W","width":"5.006mm","height":"3.006mm","path":"symbols/MACIRCLE_W.png"},"children":[]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"],"anchors":["AJPHSB0P5104028001","AJPHSB0P5104028002","AJPHSB0P5104028003","AJPHSB0P5104028004","AJPHSB0P5104028005","AJPHSB0P5104028006","AJPHSB0P5104028007","AJPHSB0P5104028008"],"images":[],"references":[{"targetId":"AJPHSB0P5104001","anchor":"","title":"Проверка системы АКПП","available":true},{"targetId":"AJPHSB0P5106004","anchor":"","title":"Проверка жидкости АКПП","available":true},{"targetId":"AJPHSB0P5106005","anchor":"","title":"Замена жидкости АКПП","available":true},{"targetId":"AJPHSB0P5106007","anchor":"","title":"Снятие/установка корпуса клапана","available":true},{"targetId":"AJPHSB0P5106008","anchor":"","title":"Проверка соленоида","available":true},{"targetId":"AJPHSB0P5106009","anchor":"","title":"Снятие/установка TCM (контроллера АКПП)","available":true},{"targetId":"AJPHSB0P5106007","anchor":"","title":"Снятие/установка корпуса клапана","available":true}],"sourceCounts":{"table":2,"testgroup":4,"result":8,"action":8,"attention1":1,"attention3":1,"intxref":1,"intxreftitleoff1":6},"searchText":"Условия обнаружения DTC и возможные места неисправности Условие обнаружения Возможное место неисправности P0747: Соленоид гидравлического управления A застрял во включенном состоянии. Передачи не переключаются в соответствии с контролем TCM (контроллера АКПП). (логика обнаружения 2D/C) соленоид линейного давления Соленоиды гидравлического управления A, B и C TCM (контроллер АКПП) P0777: Соленоид B гидравлического управления застрял во включенном состоянии. Передачи не переключаются в соответствии с контролем TCM (контроллера АКПП). (логика обнаружения 2D/C) P0797: Соленоид C гидравлического управления застрял во включенном состоянии. Передачи не переключаются в соответствии с контролем TCM (контроллера АКПП). (логика обнаружения 2D/C) Процедура воспроизведения кода неисправности Несоблюдение следующих пунктов при проведении пробной поездки может привести к несчастному случаю. Выбирайте дороги с хорошей видимостью, например, с низкой интенсивностью движения, ровными дорогами и небольшим количеством зданий или перекрестков. Тест проводится двумя людьми, водителем и испытателем, причем водитель должен вести машину осторожно и учитывать окружающие условия. Выполняйте в условиях, соответствующих дорожным условиям (разрешенная скорость и т. д.). Если во время процедуры воспроизведения первым обнаруживается другой код неисправности, приоритет отдается диагностике неисправности другого кода неисправности. Предпосылки: Выполните действия для воспроизведения при следующих условиях: Следующие коды DTC не обнаруживаются: U0073, U0100. Полностью прогрейте двигатель. Двигайтесь в течение 1 минуты со скоростью примерно 50 км/ч в диапазоне D. Диагностика неисправностей Вы проводили «проверку системы A/T»? Перейдите к шагу 2. Проверка системы АКПП — выполните. Проверка жидкости АКПП Проверьте уровень жидкости АКПП и ее износ. Проверка жидкости АКПП Результаты проверки хорошие? Перейдите к шагу 3. Залейте или замените жидкость АКПП. Замена жидкости АКПП Проверка соленоида Снимите корпус клапана. Снятие/установка корпуса клапана Проверьте соответствующий соленоид по таблице ниже. Проверка соленоида Результаты проверки хорошие? Перейдите к шагу 4. Замените корпус клапана. Проверка корпуса клапана Убедитесь, что каждый масляный канал в корпусе клапана не засорен. Результаты проверки хорошие? Замените TCM (контроллер АКПП) и проверьте еще раз. Снятие/установка TCM (контроллера АКПП) Очистите или замените корпус клапана. Снятие/установка корпуса клапана Шаг 3. Стол для проверки соленоидов. DTC соленоид линейного давления Соленоид гидравлического управления A Соленоид гидравлического управления B Соленоид гидравлического управления C P0747 P0777 P0797","sourceSha256":"48773ad814ff52f455188dab806aa95f9eaa9477ac3413e46eeed409adebeb21","sectionId":"51","groupTitle":"Диагностика","variant":null}
