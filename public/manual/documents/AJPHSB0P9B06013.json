c5205d789ba92927acbcba43821ad238ec54953a8aa","sourceBytes":57350},{"sourceName":"IGSA0P9B0078.jpg","path":"images/IGSA0P9B0078.webp","width":767,"height":680,"sha256":"c7d0c82cab1897460b4939975df5f40780d136a82f078d5751b99ab1e679c61b","sourceSha256":"1b6899da060c1f135059a248bf5c2326b9ec7f2650e2dc41c6e10c35953fe247","sourceBytes":38079},{"sourceName":"IGSA0P9B0079.jpg","path":"images/IGSA0P9B0079.webp","width":1699,"height":544,"sha256":"4e5109e78f0cb17e1655c682a7266614e0d3a684a904d07bd0345504a576beee","sourceSha256":"f59baa0173db40124a3ea2a8e6a34821faa5669eedfacc323ac9b8d64f70ecdf","sourceBytes":52772},{"sourceName":"IGSA0P9B0080.jpg","path":"images/IGSA0P9B0080.webp","width":1642,"height":2419,"sha256":"e19e43c09595466a515ce8105fadb3a572c46665c5c3c56e0741cedb9bb202a8","sourceSha256":"50095e6c96210276a0eae128753562b1b91d5672df5fe21dbaab0641b4a4535d","sourceBytes":273296}],"references":[{"targetId":"AJPHSB0P9B06024","anchor":"","title":"Способ ремонта зоны заливки пеной","available":true},{"targetId":"AJPHSB0P9B04006","anchor":"","title":"Внешние размеры бокового кузова","available":true},{"targetId":"AJPHSB0P9B04007","anchor":"","title":"Внутренние размеры бокового кузова","available":true},{"targetId":"AJPHSB0P9B04003","anchor":"","title":"зазор панели","available":true}],"sourceCounts":{"graphic":8,"table":6,"intxref":1,"intxreftitleoff1":3},"searchText":"Меры предосторожности во время работы Способ сварки и количество точек сварки симметричны, за исключением указанных мест. Размеры, указанные для положения черновой резки и положения режущего соединения, являются справочными значениями. Местоположение определите по состоянию автомобиля с учетом габаритов пополнения. Эта рабочая зона включает в себя зону наполнения пеной. Поэтому, что касается мер предосторожности при работе и методов ремонта, Способ ремонта зоны заливки пеной Пожалуйста, обратитесь к следующему, чтобы выполнить работу. Удаление Поднимите выступ и снимите внешнюю боковую панель кузова (стойка B) и усилитель петель задней двери (встроенная внутренняя панель центральной стойки) в указанном порядке, следуя методу и процедуре работы, показанным на схеме. : Нагрейте область вокруг зоны заливки до температуры не выше 170°С и удалите пену. 1. Положение обрезки внешней панели средней стойки (разрез рядом с указанным положением) [A]: Внутри автомобиля [B]: вне автомобиля [B]: вне автомобиля Установка Снимите боковой усилитель крыши с усиления центральной стойки. Установите фиксатор дверной защелки и фиксатор петли задней двери. После подтверждения положения установки с помощью габаритного чертежа выполните установку в соответствии с положением сварки, методом сварки и количеством точек сварки, указанными на чертеже. Внешняя сторона корпуса: Внешние размеры бокового кузова Внутренняя часть корпуса: Внутренние размеры бокового кузова Нанесите антикоррозийный воск на обратную сторону непрерывных сварных швов. Работы будут продолжаться с учетом установки деталей, связанных с внешним видом. зазор панели [B]: вне автомобиля [A]: Внутри автомобиля [B]: вне автомобиля 1. пенопластовый материал 2. Внешняя боковая панель кузова (стойка B) 3. усиление петель задней двери","sourceSha256":"d9d513b068b4996c9aa8f5e8764d0fffb91c3497ee1aaf4612d5bddd26365b20","sectionId":"9B","groupTitle":"Обслуживание","variant":null}
