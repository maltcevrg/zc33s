idth":547,"height":482,"sha256":"64a6a8723aaae05919c5eebcdd7d91ef67e8ee75b51d2e9972e80f071c67aa00","sourceSha256":"b1276cf09fcb087a1ddfa0c65827dbd7f31dec80cdac06d353c054d9cbac2934","sourceBytes":43035},{"sourceName":"IFRA0B510045.swf","path":"images/IFRA0B510045.webp","width":835,"height":644,"sha256":"9af61140a8f0091468d871d53b08e107273987b387fee6d4f22a18179f1b5cc5","sourceSha256":"6de3d07c5125e40ff1ee708602c864432a11bfce1eed80ef11af34bc52fc1d1d","sourceBytes":73981},{"sourceName":"IEL10C510401.swf","path":"images/IEL10C510401.webp","width":731,"height":598,"sha256":"8a1f11fd9e226a967e5b56fc49bef1de5bb6b52a1038be4f12fca36fba69de2b","sourceSha256":"859153b2e47a28efb2eeaabaeff322a0dfd8c4d94b9b0e5ef950d88ce70cbad8","sourceBytes":90195}],"references":[{"targetId":"AJPHSB0P5106018","anchor":"","title":"Разборка АКПП в сборе","available":true},{"targetId":"AJPHSB0P5106020","anchor":"","title":"АКПП в сборе","available":true},{"targetId":"AJPHSB0P5106017","anchor":"","title":"Схема внутренней конфигурации узла АКПП","available":true}],"sourceCounts":{"graphic":10,"torqueitem":3,"servicetoolitem":10,"materialitem":1,"intxrefpoff":3},"searchText":"Разборка АКПП в сборе АКПП в сборе Схема внутренней конфигурации узла АКПП Разложение Снимите стопорную пластину масляного резервуара (1) и смазочную трубку (2). Снимите боковой сальник дифференциала (1) с помощью плоской отвертки и т. п. Используя специальный инструмент, снимите наружное кольцо легкого конического роликоподшипника шестерни и встречной ведомой шестерни. Специальный инструмент (A) 09944–96013 (B) 09942–15511 (C) 09921–26010 Используя специальный инструмент, снимите наружное кольцо конического роликоподшипника боковой фары дифференциала. Специальный инструмент (A) 09944–96013 (B) 09942–15511 (C) 09921–26010 Снимите заглушку корпуса гидротрансформатора (1). Сборка Нанесите жидкость для коробки передач на новое уплотнительное кольцо и установите его на заглушку корпуса гидротрансформатора. Затяните пробку корпуса гидротрансформатора указанным моментом. Момент затяжки заглушка корпуса гидротрансформатора a 7.5 Нм Установите новое наружное кольцо конического роликоподшипника дифференциала, используя специальный инструмент. Специальный инструмент (A) 09924–74510 (B) 09944–88220 Установите новую наружную обойму легкого конического роликоподшипника ведущей шестерни и встречной шестерни с помощью специального инструмента. Специальный инструмент (A) 09913–75510 Установите новый боковой сальник дифференциала в корпус гидротрансформатора с помощью специального инструмента. Специальный инструмент (A) 09945–56510 Глубина запрессовки бокового сальника дифференциала “a”：18.6～19.6 mm Нанесите смазку на кромку бокового сальника дифференциала. смазка 99000–25030 Сузуки Супер Смазка C Установите стопорную пластину масляного резервуара (1) и смазочную трубку (2) и затяните болт стопорной пластины масляного резервуара и болт зажима смазочной трубки с указанным моментом затяжки. Момент затяжки болт стопорной пластины масляного резервуара a 5.4 Нм Болт зажима смазочной трубки b 5.4 Нм","sourceSha256":"0e8316f234da48457638af4b58b310a8521da73c9894ebc3188bcf7c0bf2e10e","sectionId":"51","groupTitle":"Обслуживание","variant":null}
