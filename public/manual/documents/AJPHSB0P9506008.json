dren":["\n",{"tag":"ptxt","attrs":{},"children":["\nТерминал\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"3","align":"right"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n[C]:\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"4","align":"left"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nэлектродвигатель стеклоподъемника водителя\n"]},"\n"]},"\n"]},"\n",{"tag":"row","attrs":{},"children":["\n",{"tag":"entry","attrs":{"colname":"1","align":"right"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n[B]:\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"2","align":"left"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nНаправление срабатывания\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"3","align":"right"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\n[D]:\n"]},"\n"]},"\n",{"tag":"entry","attrs":{"colname":"4","align":"left"},"children":["\n",{"tag":"ptxt","attrs":{},"children":["\nЭлектродвигатель стеклоподъемника пассажира\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"]},"\n"],"anchors":[],"images":[{"sourceName":"IGSA0P950018.jpg","path":"images/IGSA0P950018.webp","width":418,"height":882,"sha256":"55a4fe69bed51e637c2f77dab90608b3864dd5d26e2dd24c41d4595b40e6f143","sourceSha256":"883f96a2faf92c3844c6099431b245559f5fbaa55fca57812931d3ba2c8579ba","sourceBytes":27140},{"sourceName":"IFJA0P950058.swf","path":"images/IFJA0P950058.webp","width":832,"height":360,"sha256":"7308af62b1963d3270604c71b1613a0e09a609fac8cd86d0d1b7db815a4d9c95","sourceSha256":"4d24ed3f6b9c02fc6993f99d48ec3c2c2d001910138da48fb97b81d59f0867a5","sourceBytes":24239}],"references":[{"targetId":"AJPHSB0P9506009","anchor":"","title":"Первоначальные настройки системы электрических стеклоподъемников (только сиденье водителя)","available":true}],"sourceCounts":{"graphic":2,"table":2,"attention4":1,"intxreftitleoff1":1},"searchText":"При замене узла стеклоподъемника (электродвигателя стеклоподъемника сиденья водителя) работоспособность системы стеклоподъемников может ухудшиться, если не выполнить первоначальную настройку стеклоподъемника. Обязательно выполните первоначальную настройку стеклоподъемника. Первоначальные настройки системы электрических стеклоподъемников (только сиденье водителя) Проверьте работу электродвигателя, когда напряжение аккумуляторной батареи подается между клеммами электродвигателя стеклоподъемника. Если работа работает нестабильно, проверьте состояние подачи масла на направляющую стекла передней двери, внешний уплотнитель передней двери, внутренний уплотнитель передней двери и скользящие части узла стеклоподъемника. Если они в норме, замените узел стеклоподъемника. привод электродвигателя стеклоподъемника [A]: разъем со стороны водителя [B]: разъем со стороны пассажира [A]: Терминал [C]: электродвигатель стеклоподъемника водителя [B]: Направление срабатывания [D]: Электродвигатель стеклоподъемника пассажира","sourceSha256":"7475b69c219e6ad46b6ff20cc6787b60b9d9268ad14c6e3a44f87bf968f48230","sectionId":"95","groupTitle":"Обслуживание","variant":null}
