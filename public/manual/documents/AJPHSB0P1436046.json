f6f4bd84ca69659436b37fe8f1ced45db60c12b85ea5730ed60139","sourceSha256":"b8770286e50f5cac2796635480cea22acaf6f84a14f6c088dec01f872c8f225c","sourceBytes":136364},{"sourceName":"IFAE0A140126.swf","path":"images/IFAE0A140126.webp","width":727,"height":454,"sha256":"0ac1be69f6177c87dd8cf3b3fba5615f921f444260972af225dd69d7b0a2a222","sourceSha256":"a5989f5f82762c3265dedd5ea7b3c3ec5371cd49e3fae1e3ef39658c0a7ddf1d","sourceBytes":37342},{"sourceName":"I8T401142098.swf","path":"images/I8T401142098.webp","width":503,"height":656,"sha256":"e5db90a78c2294b4f194775957e1789be75700ef8b2dc40d23ae60bc783b38e0","sourceSha256":"d9d6f90519ca6e657c6149a86b4f104bc225dd5e475823f08498f42ced574d19","sourceBytes":28172},{"sourceName":"IFAE0A140127.swf","path":"images/IFAE0A140127.webp","width":607,"height":562,"sha256":"c1cf9ec8fc58c1ba95a37aac68972b94da14a2b17faa5a45912139cd1f07b2ff","sourceSha256":"715e58c8832ac7ad77115af2a0ec2970374b5a3c058a85ecafa28d4c2a3da92c","sourceBytes":38636}],"references":[{"targetId":"AJPHSB0P1436045","anchor":"","title":"Поршень/Поршневое кольцо/Шатун/Снятие/установка цилиндра","available":true},{"targetId":"AJPHSB0P1436047","anchor":"","title":"Проверка цилиндра/поршня/поршневого кольца","available":true},{"targetId":"AJPHSB0P1436048","anchor":"","title":"Проверка поршневого пальца/шатуна","available":true},{"targetId":"AJPHSB0P1436050","anchor":"","title":"Проверка шатунного подшипника коленчатого вала","available":true}],"sourceCounts":{"graphic":4,"table":1,"intxrefpoff":4},"searchText":"Поршень/Поршневое кольцо/Шатун/Снятие/установка цилиндра: K14C Разборка С помощью расширителя поршневых колец снимите с поршня первое и второе кольца. Снимите с поршня масляное кольцо. Снимите стопорное кольцо (1) и снимите поршневой палец с шатуна. Сборка Проверка цилиндра/поршня/поршневого кольца: K14C Проверка поршневого пальца/шатуна: K14C Проверка шатунного подшипника коленчатого вала: K14C Удалите нагар с поверхности поршня и кольцевой канавки. Прикрепите поршневой палец к поршню (1) и шатуну (2) следующим образом. Нанесите моторное масло на скользящие части поршневого пальца, отверстие поршневого пальца и шатун. Совместите переднюю метку (4) на головке поршня и переднюю метку (5) на шатуне, как показано на рисунке, и установите шатун. Вставьте поршневой палец в поршень и шатун. Вставьте новое стопорное кольцо (3). Установите выемку стопорного кольца (6) на противоположную сторону выемки поршня (7). Соберите поршневое кольцо, обращая внимание на следующие моменты. Первое кольцо (2) и второе кольцо (3) отмечены отметкой (1) в показанном месте. При установке этих колец на поршень устанавливайте их маркированной стороной вверх. Первое кольцо и второе кольцо отличаются формой участка контакта с поверхностью стенки цилиндра. Идентификация осуществляется по схеме. При установке смазочного кольца (4) установите проставку, а затем установите две направляющие. После установки трех колец совместите отверстия каждого кольца, как показано на рисунке. “a”: 45° 1. передний знак 2. Маслокольцевое соединение направляющей (верхняя сторона) 3. первое кольцевое соединение 4. Соединение второго кольца и проставочного кольца смазочного кольца 5. Маслосъемное кольцо рельса (нижняя сторона)","sourceSha256":"566e7197b5838b19bf896d080417feb0b01d11abfd7eb1997b6b7c7fe76d8aeb","sectionId":"14","groupTitle":"Обслуживание","variant":"K14C"}
