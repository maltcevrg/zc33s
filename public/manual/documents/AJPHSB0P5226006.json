":"c9a27ad6b3870bff933e53cdc65c52003e0711c465eb8e407b3906737808ac1c","sourceBytes":85590},{"sourceName":"I4RS0A520004.swf","path":"images/I4RS0A520004.webp","width":1342,"height":1862,"sha256":"156aab4ea79b8e9c025cf22c606c2ca24ddc8a9537c087fff4cd7bb9a9f0d784","sourceSha256":"0a91d673c9513f72b03c03b5affe1ad5bd16389c8a40e83869f3ce9d3fdf6748","sourceBytes":166903},{"sourceName":"IBP70A520004.swf","path":"images/IBP70A520004.webp","width":810,"height":875,"sha256":"8b4a0a5141f5da0a5350fc1b6eca0cfad25026a9e7a5184cee078d61db4ab16c","sourceSha256":"2a76dd627bcfffabd1ff0782a7f875cdfd1bd322a0912db5356c850db5fb96d2","sourceBytes":83884}],"references":[{"targetId":"AJPHSB0P9806013","anchor":"","title":"Снятие/установка обшивки/коробки консоли","available":true},{"targetId":"AJPHSB0P1A46002","anchor":"","title":"Снятие/установка аккумулятора","available":true},{"targetId":"AJPHSB0P9806013","anchor":"","title":"Снятие/установка обшивки/коробки консоли","available":true},{"targetId":"AJPHSB0P1A46002","anchor":"","title":"Снятие/установка аккумулятора","available":true}],"sourceCounts":{"graphic":4,"servicetoolitem":1,"materialitem":1,"attention3":1,"intxreftitleoff1":4},"searchText":"Снимите коробку напольной консоли. Снятие/установка обшивки/коробки консоли Переведите рычаг переключения передач (1) в нейтральное положение, как показано на рисунке, и используйте штифт (2) в следующих условиях, чтобы зафиксировать рычаг переключения передач. приколоть Внешний диаметр: от 3,0 до 3,4 мм. Длина: 70 мм или более Снимите аккумулятор и аккумуляторный лоток. Снятие/установка аккумулятора Закрепите рычаг троса переключения передач (1) и направляющую коробку (2) с помощью специального инструмента. (A) 09928–45710 Переведите рычаг переключения передач в положение 5-й или 6-й передачи. Сдвиньте и снимите стопорную пластину (1), фиксирующую держатель конца троса (2). Вытолкните держатель конца троса из регулятора (4), используя инструмент (3), как показано на рисунке. Нанесите смазку на шарнирную часть (5) рычага переключения передач и установите регулятор (1) на рычаг переключения передач. “A” смазка 99000–25011 Сузуки Супер Смазка А Нажмите держатель конца кабеля (2) в направлении [a]. Не перемещайте регулятор в направлении действия троса управления выбором передачи [b]. Сдвиньте стопорную пластину (3) в направлении [c] до тех пор, пока она не пройдет через захватную часть (4) держателя конца троса. Удалите специальный инструмент, закрепленный на шаге 3). Удалите штифт, закрепленный на шаге 2). Установите коробку напольной консоли. Снятие/установка обшивки/коробки консоли Установите аккумуляторный лоток и батарею. Снятие/установка аккумулятора","sourceSha256":"88d870ec10452ffa865b6e391cd2fc8bc0aac5eaf202d4b55e4a9db98fca05cd","sectionId":"52","groupTitle":"Обслуживание","variant":"6MT"}
